                        question: "Vị vua nào đã ban 'Chiếu dời đô' về Thăng Long năm 1010?",
                        options: ["A. Lý Thái Tổ (Lý Công Uẩn)", "B. Lê Lợi", "C. Trần Hưng Đạo", "D. Đinh Tiên Hoàng"],
                        answer: 0,
                        explain: "Lý Thái Tổ dời đô từ Hoa Lư về Đại La (Thăng Long) năm 1010."
                    },
                    {
                        id: 3,
                        question: "Chiến thắng Điện Biên Phủ 'lừng lẫy 5 châu' diễn ra vào năm nào?",
                        options: ["A. 1945", "B. 1954", "C. 1975", "D. 1968"],
                        answer: 1,
                        explain: "Chiến dịch Điện Biên Phủ toàn thắng ngày 7/5/1954."
                    },
                    {
                        id: 4,
                        question: "Ai là người lãnh đạo cuộc khởi nghĩa Lam Sơn?",
                        options: ["A. Quang Trung", "B. Lê Lợi", "C. Nguyễn Trãi", "D. Trần Bình Trọng"],
                        answer: 1,
                        explain: "Lê Lợi là người xưng Bình Định Vương lãnh đạo khởi nghĩa Lam Sơn."
                    }
                ]
            },
            gdcd: {
                title: "Giáo Dục Công Dân THCS",
                icon: "fa-hand-holding-heart",
                color: "from-purple-500 to-indigo-600",
                questions: [
                    {
                        id: 1,
                        question: "Hành vi nào sau đây thể hiện sự tôn trọng kỷ luật và pháp luật?",
                        options: ["A. Đi xe máy không đội mũ bảo hiểm", "B. Đi học đúng giờ, chấp hành luật giao thông", "C. Ném rác ra bãi trống", "D. Quay cop trong giờ kiểm tra"],
                        answer: 1,
                        explain: "Đi học đúng giờ và tuân thủ luật thể hiện tính kỷ luật và văn hóa ứng xử."
                    },
                    {
                        id: 2,
                        question: "Siêng năng, kiên trì sẽ giúp học sinh đạt được điều gì?",
                        options: ["A. Dễ bỏ cuộc khi gặp khó", "B. Vượt qua khó khăn và đạt thành công", "C. Ỷ ỉa vào người khác", "D. Mất thời gian vô ích"],
                        answer: 1,
                        explain: "Kiên trì giúp ta tích lũy kinh nghiệm và đạt thành quả cao."
                    },
                    {
                        id: 3,
                        question: "Quyền nào sau đây là quyền cơ bản của trẻ em Việt Nam?",
                        options: ["A. Quyền được sống, học tập và bảo vệ", "B. Quyền lái xe ô tô", "C. Quyền tham gia bầu cử đại biểu", "D. Quyền kinh doanh bất động sản"],
                        answer: 0,
                        explain: "Trẻ em có quyền được chăm sóc, học tập và bảo vệ toàn diện."
                    },
                    {
                        id: 4,
                        question: "Tình hữu nghị giữa các dân tộc trên thế giới mang lại lợi ích gì?",
                        options: ["A. Gây mâu thuẫn xung đột", "B. Hợp tác phát triển hòa bình và gắn kết", "C. Phân biệt đối xử", "D. Cô lập quốc gia"],
                        answer: 1,
                        explain: "Hữu nghị tạo môi trường hòa bình, cùng hợp tác phát triển kinh tế văn hóa."
                    }
                ]
            }
        };

        /* ================= STATE MANAGEMENT ================= */
        let currentSubjectKey = null;
        let currentQuestions = [];
        let userAnswers = {}; // { questionIndex: selectedOptionIndex }
        let timerInterval = null;
        let secondsElapsed = 0;
        let userStats = {
            totalScore: 0,
            completedCount: 0
        };

        /* ================= LOGIC CHUYỂN VIEW & MODAL ================= */
        function switchView(viewName) {
            document.getElementById('view-home').classList.add('hidden');
            document.getElementById('view-quiz').classList.add('hidden');
            document.getElementById('view-result').classList.add('hidden');

            if (viewName === 'home') {
                document.getElementById('view-home').classList.remove('hidden');
                clearInterval(timerInterval);
            } else if (viewName === 'quiz') {
                document.getElementById('view-quiz').classList.remove('hidden');
            } else if (viewName === 'result') {
                document.getElementById('view-result').classList.remove('hidden');
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Chọn môn & Hiện thông báo Modal
        function selectSubject(key) {
            currentSubjectKey = key;
            const data = quizDatabase[key];
            if (!data) return;

            // Setup Modal Thông báo
            const modal = document.getElementById('welcome-modal');
            document.getElementById('modal-subject-title').innerText = data.title;
            document.getElementById('modal-icon').className = `fa-solid ${data.icon}`;
            document.getElementById('modal-icon-bg').className = `w-12 h-12 rounded-2xl flex items-center justify-center text-white text-xl font-bold bg-gradient-to-r ${data.color} shadow-md`;
            
            modal.classList.remove('hidden');
        }

        // Bắt đầu làm bài từ Modal
        function startQuizNow() {
            document.getElementById('welcome-modal').classList.add('hidden');
            const data = quizDatabase[currentSubjectKey];
            
            // Set Header Quiz
            document.getElementById('quiz-title').innerText = data.title;
            currentQuestions = data.questions;
            userAnswers = {};
            secondsElapsed = 0;

            // Render giao diện câu hỏi
            renderQuestions();
            renderQuestionNav();
            startTimer();

            switchView('quiz');
        }

        /* ================= LOGIC THỜI GIAN & ĐỒNG HỒ ================= */
        function startTimer() {
            clearInterval(timerInterval);
            document.getElementById('quiz-timer').innerText = "00:00";
            timerInterval = setInterval(() => {
                secondsElapsed++;
                const mins = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
                const secs = String(secondsElapsed % 60).padStart(2, '0');
                document.getElementById('quiz-timer').innerText = `${mins}:${secs}`;
            }, 1000);
        }

        /* ================= RENDER CÂU HỎI VÀ LỰA CHỌN ================= */
        function renderQuestions() {
            const container = document.getElementById('questions-container');
            container.innerHTML = '';

            currentQuestions.forEach((q, qIdx) => {
                const card = document.createElement('div');
                card.id = `question-card-${qIdx}`;
                card.className = "bg-white p-6 rounded-2xl border border-slate-200 shadow-sm transition-all duration-300";

                let optionsHTML = '';
                q.options.forEach((opt, optIdx) => {
                    optionsHTML += `
                        <button id="opt-btn-${qIdx}-${optIdx}" onclick="selectAnswer(${qIdx}, ${optIdx})" 
                            class="w-full text-left p-4 rounded-xl border border-slate-200 hover:bg-sky-50 hover:border-sky-300 transition-all flex items-center justify-between group cursor-pointer mb-2">
                            <span class="text-sm font-medium text-slate-700 group-hover:text-sky-900">${opt}</span>
                            <div class="opt-indicator w-5 h-5 rounded-full border-2 border-slate-300 flex items-center justify-center group-hover:border-sky-500">
                                <div class="w-2.5 h-2.5 rounded-full bg-sky-500 hidden"></div>
                            </div>
                        </button>
                    `;
                });

                card.innerHTML = `
                    <div class="flex items-center justify-between mb-4">
                        <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-sky-100 text-sky-700">Câu ${qIdx + 1}/${currentQuestions.length}</span>
                        <span class="text-xs text-slate-400 font-semibold"><i class="fa-solid fa-star text-amber-400 mr-1"></i>25 Điểm</span>
                    </div>
                    <h3 class="text-base sm:text-lg font-bold text-slate-800 mb-4">${q.question}</h3>
                    <div class="space-y-2">
                        ${optionsHTML}
                    </div>
                    <!-- Giải thích khi nộp bài -->
                    <div id="explain-${qIdx}" class="hidden mt-4 p-4 rounded-xl text-xs sm:text-sm border"></div>
                `;

                container.appendChild(card);
            });

            updateProgressBar();
        }

        // Render Sidebar Nav Dots
        function renderQuestionNav() {
            const navGrid = document.getElementById('question-nav-grid');
            navGrid.innerHTML = '';

            currentQuestions.forEach((_, qIdx) => {
                const btn = document.createElement('button');
                btn.id = `nav-dot-${qIdx}`;
                btn.className = "w-full py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-500 hover:bg-slate-100 transition-all";
                btn.innerText = qIdx + 1;
                btn.onclick = () => {
                    document.getElementById(`question-card-${qIdx}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
                };
                navGrid.appendChild(btn);
            });
        }

        /* ================= HỆ THỐNG LỰA CHỌN ĐÁP ÁN REALTIME ================= */
        function selectAnswer(qIdx, optIdx) {
            userAnswers[qIdx] = optIdx;

            // Cập nhật UI nút chọn
            const q = currentQuestions[qIdx];
            q.options.forEach((_, idx) => {
                const btn = document.getElementById(`opt-btn-${qIdx}-${idx}`);
                const dot = btn.querySelector('.opt-indicator div');
                const circle = btn.querySelector('.opt-indicator');

                if (idx === optIdx) {
                    btn.className = "w-full text-left p-4 rounded-xl border-2 border-sky-500 bg-sky-50/80 transition-all flex items-center justify-between group cursor-pointer mb-2 shadow-sm";
                    dot.classList.remove('hidden');
                    circle.className = "w-5 h-5 rounded-full border-2 border-sky-600 flex items-center justify-center bg-sky-500";
                    dot.className = "w-2 h-2 rounded-full bg-white";
                } else {
                    btn.className = "w-full text-left p-4 rounded-xl border border-slate-200 hover:bg-sky-50 hover:border-sky-300 transition-all flex items-center justify-between group cursor-pointer mb-2";
                    dot.classList.add('hidden');
                    circle.className = "w-5 h-5 rounded-full border-2 border-slate-300 flex items-center justify-center group-hover:border-sky-500";
                }
            });

            // Cập nhật Sidebar Dot
            const navDot = document.getElementById(`nav-dot-${qIdx}`);
            navDot.className = "w-full py-2.5 rounded-xl bg-sky-500 text-white font-bold text-xs shadow-md shadow-sky-500/20";

            updateProgressBar();
        }

        function updateProgressBar() {
            const total = currentQuestions.length;
            const answered = Object.keys(userAnswers).length;
            const pct = Math.round((answered / total) * 100);
            document.getElementById('quiz-progress-bar').style.width = `${pct}%`;
        }

        /* ================= HỆ THỐNG GIÁM SÁT & CHẤM ĐIỂM TỰ ĐỘNG ================= */
        function submitQuiz() {
            clearInterval(timerInterval);

            let correctCount = 0;
            const total = currentQuestions.length;

            currentQuestions.forEach((q, qIdx) => {
                const userChoice = userAnswers[qIdx];
                const isCorrect = userChoice === q.answer;
                const explainBox = document.getElementById(`explain-${qIdx}`);

                if (isCorrect) correctCount++;

                // Hiển thị màu sắc ĐÚNG (Xanh) / SAI (Đỏ) thực tế theo yêu cầu
                q.options.forEach((_, optIdx) => {
                    const btn = document.getElementById(`opt-btn-${qIdx}-${optIdx}`);
                    btn.onclick = null; // Khóa không cho chọn lại

                    if (optIdx === q.answer) {
                        // Đáp án ĐÚNG -> Màu xanh lá cây đậm/nhạt
                        btn.className = "w-full text-left p-4 rounded-xl border-2 border-emerald-600 bg-emerald-100 text-emerald-900 font-semibold transition-all flex items-center justify-between mb-2 shadow-sm";
                        btn.querySelector('.opt-indicator').className = "w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs";
                        btn.querySelector('.opt-indicator').innerHTML = '<i class="fa-solid fa-check"></i>';
                    } else if (optIdx === userChoice && !isCorrect) {
                        // Lựa chọn SAI -> Màu đỏ rực rỡ
                        btn.className = "w-full text-left p-4 rounded-xl border-2 border-red-500 bg-red-100 text-red-900 font-semibold transition-all flex items-center justify-between mb-2 shadow-sm";
                        btn.querySelector('.opt-indicator').className = "w-6 h-6 rounded-full bg-red-500 text-white flex items-center justify-center text-xs";
                        btn.querySelector('.opt-indicator').innerHTML = '<i class="fa-solid fa-xmark"></i>';
                    } else {
                        btn.className = "w-full text-left p-4 rounded-xl border border-slate-200 opacity-60 flex items-center justify-between mb-2";
                    }
                });

                // Hiển thị Lời giải chi tiết
                explainBox.classList.remove('hidden');
                if (isCorrect) {
                    explainBox.className = "mt-4 p-4 rounded-xl text-xs sm:text-sm bg-emerald-50 border border-emerald-200 text-emerald-800 font-medium";
                    explainBox.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600 mr-2"></i><strong>Chính xác!</strong> ${q.explain}`;
                } else {
                    explainBox.className = "mt-4 p-4 rounded-xl text-xs sm:text-sm bg-red-50 border border-red-200 text-red-800 font-medium";
                    explainBox.innerHTML = `<i class="fa-solid fa-circle-xmark text-red-600 mr-2"></i><strong>Chưa chính xác:</strong> ${q.explain}`;
                }
            });

            // Tính điểm số (Thang 100)
            const scorePerQuestion = 100 / total;
            const finalScore = Math.round(correctCount * scorePerQuestion);

            // Cập nhật thống kê người dùng
            userStats.totalScore += finalScore;
            userStats.completedCount += 1;
            document.getElementById('header-total-score').innerText = `Tổng điểm: ${userStats.totalScore} DP`;
            document.getElementById('header-completed-count').innerText = `Đã hoàn thành: ${userStats.completedCount} Bài`;
            document.getElementById('header-user-stats').classList.remove('hidden');

            // Xếp loại học lực xuất sắc
            let rankText = "CẦN CỐ GẮNG";
            let rankClass = "bg-rose-100 text-rose-800";
            let rankIcon = "fa-triangle-exclamation";
            let messageText = "Bạn cần ôn tập lại kiến thức bài học này kỹ hơn nhé!";

            if (finalScore >= 90) {
                rankText = "XUẤT SẮC";
                rankClass = "bg-emerald-100 text-emerald-800";
                rankIcon = "fa-trophy";
                messageText = "Tuyệt vời! Kiến thức của bạn cực kỳ vững chắc!";
                // Bắn pháo hoa ăn mừng
                if (typeof confetti === 'function') {
                    confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
                }
            } else if (finalScore >= 75) {
                rankText = "GIỎI";
                rankClass = "bg-sky-100 text-sky-800";
                rankIcon = "fa-award";
                messageText = "Kết quả rất tốt! Hãy tiếp tục phát huy ở các bài học khác.";
            } else if (finalScore >= 50) {
                rankText = "KHÁ";
                rankClass = "bg-amber-100 text-amber-800";
                rankIcon = "fa-star-half-stroke";
                messageText = "Khá tốt! Bạn chỉ cần chú ý kĩ hơn ở một vài câu hỏi.";
            }

            // Render Dashboard Kết quả
            document.getElementById('result-rank-tag').innerText = rankText;
            document.getElementById('result-rank-tag').className = `inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider ${rankClass} mb-2`;
            document.getElementById('result-icon').className = `fa-solid ${rankIcon} text-4xl`;
            document.getElementById('result-message').innerText = messageText;

            document.getElementById('res-score').innerText = `${finalScore}/100`;
            document.getElementById('res-correct').innerText = `${correctCount}/${total}`;
            document.getElementById('res-incorrect').innerText = `${total - correctCount}/${total}`;
            
            const mins = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
            const secs = String(secondsElapsed % 60).padStart(2, '0');
            document.getElementById('res-time').innerText = `${mins}:${secs}`;

            switchView('result');
        }

        // Xem lại bài làm từ trang kết quả
        function reviewAnswers() {
            switchView('quiz');
        }
    </script>
</body>
