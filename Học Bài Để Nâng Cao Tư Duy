<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ Thống Học Tập Tương Tác THCS</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                        },
                        correct: {
                            light: '#86efac', // Xanh lá nhạt
                            dark: '#15803d',  // Xanh lá đậm
                            bg: '#f0fdf4'
                        },
                        incorrect: {
                            main: '#ef4444',
                            bg: '#fef2f2'
                        }
                    },
                    animation: {
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'float': 'float 3s ease-in-out infinite',
                        'spin-slow': 'spin 8s linear infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-8px)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* SVG Animated Effects */
        .subject-card:hover .svg-animate-spin {
            transform: rotate(180deg);
            transition: transform 0.8s ease-in-out;
        }
        .subject-card:hover .svg-bounce {
            transform: translateY(-5px);
            transition: transform 0.3s ease;
        }
        .chem-flask-bubble {
            animation: float 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- HEADER / NAVIGATION -->
    <header class="sticky top-0 z-40 bg-white/80 backdrop-filter backdrop-blur-md border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchView('home')">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-sky-500/20">
                    <i class="fa-solid me-0 fa-graduation-cap text-xl"></i>
                </div>
                <div>
                    <span class="font-extrabold text-xl bg-clip-text text-transparent bg-gradient-to-r from-sky-600 to-indigo-700">EduTHCS Pro</span>
                    <span class="text-xs block text-slate-400 font-medium">Hệ Thống Tương Tác Thực Tế</span>
                </div>
            </div>

            <!-- User Info / Stats Header -->
            <div id="header-user-stats" class="hidden sm:flex items-center space-x-6">
                <div class="flex items-center space-x-2 bg-slate-100 px-3 py-1.5 rounded-full text-xs font-semibold text-slate-600">
                    <i class="fa-solid fa-trophy text-amber-500"></i>
                    <span id="header-total-score">Tổng điểm: 0 DP</span>
                </div>
                <div class="flex items-center space-x-2 bg-slate-100 px-3 py-1.5 rounded-full text-xs font-semibold text-slate-600">
                    <i class="fa-solid fa-circle-check text-emerald-500"></i>
                    <span id="header-completed-count">Đã hoàn thành: 0 Bài</span>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">

        <!-- VIEW 1: TRANG CHỦ MÔN HỌC (HOME) -->
        <section id="view-home" class="space-y-8">
            <!-- Banner Chào Mừng -->
            <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-sky-600 via-indigo-600 to-purple-700 text-white p-6 sm:p-10 shadow-xl">
                <div class="relative z-10 max-w-2xl">
                    <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-md text-xs font-semibold uppercase tracking-wider rounded-full mb-3">Nền Tảng Học Tập 4.0</span>
                    <h1 class="text-3xl sm:text-4xl font-extrabold mb-3 leading-tight">Khám Phá Tri Thức & Kiểm Tra Thực Tế</h1>
                    <p class="text-sky-100 text-sm sm:text-base mb-6">Chọn môn học hoặc các phân lớp Hóa Học từ lớp 6 đến lớp 9 để bắt đầu luyện tập, làm bài thực hành và nhận kết quả chấm điểm tức thì!</p>
                </div>
                <!-- Background Decorative SVG -->
                <svg class="absolute right-0 bottom-0 top-0 h-full w-1/2 opacity-20 pointer-events-none hidden md:block" viewBox="0 0 400 400" fill="none">
                    <circle cx="200" cy="200" r="150" stroke="white" stroke-width="2" stroke-dasharray="10 10" />
                    <circle cx="200" cy="200" r="100" stroke="white" stroke-width="4" />
                    <polygon points="200,80 230,160 310,160 245,205 270,285 200,235 130,285 155,205 90,160 170,160" fill="white" />
                </svg>
            </div>

            <!-- PHÂN MÔN: HOÁ HỌC LỚP 6 - 9 -->
            <div>
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center space-x-3">
                        <div class="p-2 bg-emerald-100 rounded-lg text-emerald-600">
                            <i class="fa-solid fa-flask-vial text-xl"></i>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-slate-800">Bộ Môn Hóa Học THCS</h2>
                            <p class="text-xs text-slate-500">Phân loại chương trình lý thuyết và bài tập theo từng khối lớp 6, 7, 8, 9</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    <!-- Hóa học 6 -->
                    <div onclick="selectSubject('hoa6')" class="subject-card glass-card rounded-2xl p-5 hover:shadow-xl transition-all duration-300 cursor-pointer border hover:border-emerald-400 group relative overflow-hidden">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center shadow-lg shadow-emerald-500/30 group-hover:scale-110 transition-transform">
                                <!-- SVG Flask Anim -->
                                <svg class="w-8 h-8 text-white svg-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L5.6 15.12a2 2 0 00-1.183.184l-1.99 1.026A2 2 0 001.378 18.2v.8A2 2 0 003.378 21h17.244a2 2 0 002-2v-.8a2 2 0 00-1.05-1.758l-2.144-1.014zM12 3v9 shadow"></path>
                                </svg>
                            </div>
                            <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">Khối 6</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-1 group-hover:text-emerald-600 transition-colors">Hóa Học Lớp 6</h3>
                        <p class="text-xs text-slate-500 mb-4">Nhận biết chất, hỗn hợp, thể của chất và chất tinh khiết cơ bản.</p>
                        <div class="flex items-center justify-between text-xs font-semibold text-emerald-600 pt-3 border-t border-slate-100">
                            <span>4 Bài Thực Tế</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- Hóa học 7 -->
                    <div onclick="selectSubject('hoa7')" class="subject-card glass-card rounded-2xl p-5 hover:shadow-xl transition-all duration-300 cursor-pointer border hover:border-teal-400 group relative overflow-hidden">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-teal-400 to-cyan-600 flex items-center justify-center shadow-lg shadow-teal-500/30 group-hover:scale-110 transition-transform">
                                <!-- SVG Atom Anim -->
                                <svg class="w-8 h-8 text-white svg-animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="3" stroke-width="2"/>
                                    <ellipse cx="12" cy="12" rx="9" ry="4" stroke-width="1.5" transform="rotate(30 12 12)"/>
                                    <ellipse cx="12" cy="12" rx="9" ry="4" stroke-width="1.5" transform="rotate(150 12 12)"/>
                                </svg>
                            </div>
                            <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-teal-50 text-teal-700 border border-teal-200">Khối 7</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-1 group-hover:text-teal-600 transition-colors">Hóa Học Lớp 7</h3>
                        <p class="text-xs text-slate-500 mb-4">Nguyên tử, Nguyên tố hoá học, Cấu trúc bảng tuần hoàn.</p>
                        <div class="flex items-center justify-between text-xs font-semibold text-teal-600 pt-3 border-t border-slate-100">
                            <span>4 Bài Thực Tế</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- Hóa học 8 -->
                    <div onclick="selectSubject('hoa8')" class="subject-card glass-card rounded-2xl p-5 hover:shadow-xl transition-all duration-300 cursor-pointer border hover:border-cyan-400 group relative overflow-hidden">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/30 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-vial-circle-check text-2xl text-white svg-bounce"></i>
                            </div>
                            <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-cyan-50 text-cyan-700 border border-cyan-200">Khối 8</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-1 group-hover:text-cyan-600 transition-colors">Hóa Học Lớp 8</h3>
                        <p class="text-xs text-slate-500 mb-4">Phản ứng hóa học, Độc lượng Mol, Tính toán phương trình.</p>
                        <div class="flex items-center justify-between text-xs font-semibold text-cyan-600 pt-3 border-t border-slate-100">
                            <span>4 Bài Thực Tế</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- Hóa học 9 -->
                    <div onclick="selectSubject('hoa9')" class="subject-card glass-card rounded-2xl p-5 hover:shadow-xl transition-all duration-300 cursor-pointer border hover:border-indigo-400 group relative overflow-hidden">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/30 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-fire-burner text-2xl text-white svg-bounce"></i>
                            </div>
                            <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">Khối 9</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-1 group-hover:text-indigo-600 transition-colors">Hóa Học Lớp 9</h3>
                        <p class="text-xs text-slate-500 mb-4">Hợp chất vô cơ: Axit, Bazơ, Muối, Kim loại và Hóa hữu cơ.</p>
                        <div class="flex items-center justify-between text-xs font-semibold text-indigo-600 pt-3 border-t border-slate-100">
                            <span>4 Bài Thực Tế</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CÁC BỘ MÔN KHÁC -->
            <div class="pt-4">
                <div class="flex items-center space-x-3 mb-4">
                    <div class="p-2 bg-indigo-100 rounded-lg text-indigo-600">
                        <i class="fa-solid fa-shapes text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-slate-800">Các Bộ Môn THCS Tương Tác khác</h2>
                        <p class="text-xs text-slate-500">Toán, Ngữ Văn, Sinh Học, Vật Lý, Lịch Sử và Giáo Dục Công Dân</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- TOÁN HỌC -->
                    <div onclick="selectSubject('toan')" class="subject-card glass-card rounded-2xl p-6 hover:shadow-xl transition-all duration-300 cursor-pointer border hover:border-blue-400 group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-blue-500/30 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-calculator text-2xl svg-bounce"></i>
                            </div>
                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-blue-50 text-blue-700">Toán Học</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-blue-600 transition-colors">Bộ Môn Toán Học</h3>
                        <p class="text-xs text-slate-500 mb-4">Đại số, hình học phẳng, tư duy logic và giải bài toán thực tế.</p>
                        <div class="flex items-center justify-between text-xs font-semibold text-blue-600">
                            <span>Vào Kiểm Tra</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- NGỮ VĂN -->
                    <div onclick="selectSubject('van')" class="subject-card glass-card rounded-2xl p-6 hover:shadow-xl transition-all duration-300 cursor-pointer border hover:border-rose-400 group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-rose-500 to-pink-600 flex items-center justify-center text-white shadow-lg shadow-rose-500/30 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-book-open text-2xl svg-bounce"></i>
                            </div>
                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-rose-50 text-rose-700">Ngữ Văn</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-rose-600 transition-colors">Bộ Môn Ngữ Văn</h3>
                        <p class="text-xs text-slate-500 mb-4">Tác phẩm văn học, tiếng Việt, đọc hiểu và phương pháp làm văn.</p>
                        <div class="flex items-center justify-between text-xs font-semibold text-rose-600">
                            <span>Vào Kiểm Tra</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- SINH HỌC -->
                    <div onclick="selectSubject('sinh')" class="subject-card glass-card rounded-2xl p-6 hover:shadow-xl transition-all duration-300 cursor-pointer border hover:border-green-400 group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center text-white shadow-lg shadow-green-500/30 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-dna text-2xl svg-animate-spin"></i>
                            </div>
                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-green-50 text-green-700">Sinh Học</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-green-600 transition-colors">Bộ Môn Sinh Học</h3>
                        <p class="text-xs text-slate-500 mb-4">Cơ thể người, tế bào, di truyền học và hệ sinh thái đa dạng.</p>
                        <div class="flex items-center justify-between text-xs font-semibold text-green-600">
                            <span>Vào Kiểm Tra</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- VẬT LÝ -->
                    <div onclick="selectSubject('ly')" class="subject-card glass-card rounded-2xl p-6 hover:shadow-xl transition-all duration-300 cursor-pointer border hover:border-amber-400 group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center text-white shadow-lg shadow-amber-500/30 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-bolt text-2xl svg-bounce"></i>
                            </div>
                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-amber-50 text-amber-700">Vật Lý</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-amber-600 transition-colors">Bộ Môn Vật Lý</h3>
                        <p class="text-xs text-slate-500 mb-4">Cơ học, Nhiệt học, Điện học và Quang học ứng dụng thực tế.</p>
                        <div class="flex items-center justify-between text-xs font-semibold text-amber-600">
                            <span>Vào Kiểm Tra</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- LỊCH SỬ -->
                    <div onclick="selectSubject('su')" class="subject-card glass-card rounded-2xl p-6 hover:shadow-xl transition-all duration-300 cursor-pointer border hover:border-red-400 group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-red-500 to-rose-700 flex items-center justify-center text-white shadow-lg shadow-red-500/30 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-landmark text-2xl svg-bounce"></i>
                            </div>
                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-red-50 text-red-700">Lịch Sử</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-red-600 transition-colors">Bộ Môn Lịch Sử</h3>
                        <p class="text-xs text-slate-500 mb-4">Lịch sử Việt Nam, tiến trình thế giới và các mốc sự kiện quan trọng.</p>
                        <div class="flex items-center justify-between text-xs font-semibold text-red-600">
                            <span>Vào Kiểm Tra</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- GIÁO DỤC CÔNG DÂN (GDCD) -->
                    <div onclick="selectSubject('gdcd')" class="subject-card glass-card rounded-2xl p-6 hover:shadow-xl transition-all duration-300 cursor-pointer border hover:border-purple-400 group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-purple-500/30 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-hand-holding-heart text-2xl svg-bounce"></i>
                            </div>
                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-purple-50 text-purple-700">GDCD</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-purple-600 transition-colors">Giáo Dục Công Dân</h3>
                        <p class="text-xs text-slate-500 mb-4">Đạo đức lối sống, kỹ năng sống và pháp luật Việt Nam.</p>
                        <div class="flex items-center justify-between text-xs font-semibold text-purple-600">
                            <span>Vào Kiểm Tra</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- VIEW 2: GIAO DIỆN LÀM BÀI TẬP THỰC TẾ (QUIZ) -->
        <section id="view-quiz" class="hidden space-y-6">
            <!-- Top Navbar trong bài -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-white p-4 rounded-2xl border border-slate-200 shadow-sm gap-4">
                <div class="flex items-center space-x-3">
                    <button onclick="switchView('home')" class="p-2 hover:bg-slate-100 rounded-xl transition-colors text-slate-600">
                        <i class="fa-solid fa-arrow-left text-lg"></i>
                    </button>
                    <div>
                        <h2 id="quiz-title" class="font-extrabold text-lg text-slate-800">Tên Môn Học</h2>
                        <span id="quiz-subtitle" class="text-xs text-slate-500">Bài Kiểm Tra Thực Tế Giám Sát Chi Tiết</span>
                    </div>
                </div>

                <!-- Đồng hồ & Tiến trình -->
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2 bg-amber-50 text-amber-700 border border-amber-200 px-3.5 py-1.5 rounded-full font-mono text-sm font-bold">
                        <i class="fa-regular fa-clock"></i>
