        <!-- Giữa: Logo GO88 Trapezoid giống ảnh 1 -->
        <div class="header-trapezoid bg-gradient-to-b from-zinc-800 via-zinc-900 to-black border-x-2 border-b-2 border-yellow-400 px-8 sm:px-14 py-1.5 shadow-[0_0_25px_rgba(234,179,8,0.5)] flex items-center justify-center">
            <span class="text-2xl sm:text-3xl font-black tracking-widest gold-text">GO88</span>
        </div>

        <!-- Phải: Nút Âm thanh & Toàn màn hình -->
        <div class="flex items-center gap-2">
            <button onclick="toggleSound()" id="btn-sound" class="w-9 h-9 rounded-full bg-zinc-900 border border-yellow-500/50 text-yellow-400 flex items-center justify-center hover:bg-yellow-500/20">
                <i class="fa-solid fa-volume-high text-sm"></i>
            </button>
            <button onclick="openModal('modal-menu')" class="w-9 h-9 rounded-full bg-zinc-900 border border-yellow-500/50 text-yellow-400 flex items-center justify-center hover:bg-yellow-500/20 sm:hidden">
                <i class="fa-solid fa-bars text-sm"></i>
            </button>
        </div>
    </header>

    <!-- ==================== 2. KHU VỰC SẢNH CHÍNH (LOBBY) ==================== -->
    <main class="flex-1 flex flex-col justify-center items-center px-2 sm:px-6 py-2 overflow-y-auto relative">
        
        <!-- Thanh điều hướng danh mục ngang có đường nối xanh/vàng (Dựa theo ảnh 1) -->
        <div class="w-full max-w-5xl flex items-center justify-between relative mb-4 sm:mb-6 px-1">
            <!-- Đường nối ngang chạy xuyên qua các nút -->
