        // Kéo nắp nặn cứng tịnh tiến nguyên khối
        (function initHardBowlDrag() {
            const bowl = document.getElementById('hard-bowl');
            let dragging = false;
            let startX = 0, startY = 0;

            function onStart(e) {
                if (!activeRoomKey) return;
                const r = rooms[activeRoomKey];
                if (r.phase !== 'SQUEEZE' || r.revealed) return;
                dragging = true;
                const pt = e.touches ? e.touches[0] : e;
                startX = pt.clientX - (parseFloat(bowl.dataset.dx) || 0);
                startY = pt.clientY - (parseFloat(bowl.dataset.dy) || 0);
            }

            function onMove(e) {
                if (!dragging) return;
                e.preventDefault();
                const pt = e.touches ? e.touches[0] : e;
                const dx = pt.clientX - startX;
                const dy = pt.clientY - startY;
                bowl.dataset.dx = dx;
                bowl.dataset.dy = dy;
                bowl.style.transform = `translate(${dx}px, ${dy}px)`;

                // Nếu kéo nắp ra ngoài phạm vi đĩa (> 115px) -> tự động mở bát và công bố thắng
                const dist = Math.hypot(dx, dy);
                if (dist > 115) {
                    dragging = false;
                    revealSicboResult();
                }
            }

            function onEnd() {
                if (!dragging) return;
                dragging = false;
                const dx = parseFloat(bowl.dataset.dx) || 0;
                const dy = parseFloat(bowl.dataset.dy) || 0;
                // Khi thả nắp nếu đã kéo lệch > 75px thì mở luôn
                if (Math.hypot(dx, dy) > 75) {
                    revealSicboResult();
                }
            }

            bowl.addEventListener('mousedown', onStart);
            window.addEventListener('mousemove', onMove);
            window.addEventListener('mouseup', onEnd);

            bowl.addEventListener('touchstart', onStart, { passive: false });
            window.addEventListener('touchmove', onMove, { passive: false });
            window.addEventListener('touchend', onEnd);
        })();

        function revealSicboResult() {
            if (!activeRoomKey) return;
            const r = rooms[activeRoomKey];
            if (r.revealed) return;
            finalizeRoomRound(r);
        }

        function finalizeRoomRound(r) {
            if (r.revealed) return;
            r.revealed = true;

            const total = r.dice[0] + r.dice[1] + r.dice[2];
            const winSide = total >= 11 ? 'TAI' : 'XIU';

            // Lưu vào lịch sử phiên của sảnh tương ứng
            const histList = r.key === 'MD5' ? state.historyMD5 : state.historyCC;
            histList.push({
                id: r.sessionNum,
                dice: [...r.dice],
                total: total,
                res: winSide
            });
            if (histList.length > 60) histList.shift();

            // Tính toán trả thưởng tỷ lệ 1 : 1.98 (VD: đặt 50k nhận 99k)
            let payout = 0;
            if (winSide === 'TAI' && r.myPlacedTai > 0) {
                payout = Math.floor(r.myPlacedTai * 1.98);
            } else if (winSide === 'XIU' && r.myPlacedXiu > 0) {
                payout = Math.floor(r.myPlacedXiu * 1.98);
            }

            if (r.myPlacedTai > 0 || r.myPlacedXiu > 0) {
                const totalBet = r.myPlacedTai + r.myPlacedXiu;
                state.myBets.unshift({
                    session: '#' + String(r.sessionNum).padStart(6, '0'),
                    room: r.title,
                    side: r.myPlacedTai > 0 ? 'TÀI' : 'XỈU',
                    bet: totalBet,
                    win: payout,
                    result: `${winSide === 'TAI' ? 'Tài' : 'Xỉu'} (${total})`
                });
            }

            if (payout > 0) {
                state.balance += payout;
            }
            saveState();

            // Cập nhật giao diện nếu người chơi đang mở sảnh này
            if (activeRoomKey === r.key) {
                document.getElementById('hard-bowl').classList.add('hidden');
                document.getElementById('btn-quick-open').classList.add('hidden');
                document.getElementById('sicbo-phase-label').innerText = `KẾT QUẢ: ${winSide === 'TAI' ? 'TÀI' : 'XỈU'} (${total} ĐIỂM)`;
                
                // Hiệu ứng nháy ô Tài hoặc Xỉu thắng
                if (winSide === 'TAI') {
                    document.getElementById('panel-tai').classList.add('win-glow');
                } else {
                    document.getElementById('panel-xiu').classList.add('win-glow');
                }

                if (payout > 0) {
                    playBeep(1040, 0.25, 'triangle');
                    const banner = document.getElementById('win-payout-banner');
                    banner.innerText = '+' + formatMoney(payout);
                    banner.classList.remove('hidden', 'win-payout-float');
                    void banner.offsetWidth;
                    banner.classList.add('win-payout-float');
                    showToast(`Chúc mừng! Bạn thắng +${formatMoney(payout)} VNĐ!`, 'success');
                }
                renderQuickBeadStrip();
            }
        }

        // ---------- 5. BẢNG SOI CẦU BẺ BỆT & BIỂU ĐỒ ĐƯỜNG LỊCH SỬ PHIÊN (ẢNH 2) ----------
        let roadPageIndex = 0; // 0: Bảng chấm tròn | 1: Biểu đồ đường
