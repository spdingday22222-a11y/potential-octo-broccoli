                    <span class="text-yellow-300">x500</span>
                </div>
                <div class="my-3 w-20 h-20 rounded-full bg-gradient-to-tr from-yellow-600 to-yellow-300 p-1 shadow-[0_0_20px_rgba(234,179,8,0.6)] flex items-center justify-center">
