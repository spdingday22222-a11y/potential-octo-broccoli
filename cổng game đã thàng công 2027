            }
            if (pendingAmount <= 0) {
                showToast('Vui lòng chọn mệnh giá chip cược!', 'error');
                return;
            }
            if (pendingAmount > state.balance) {
                showToast('Số dư không đủ, vui lòng nạp thêm!', 'error');
