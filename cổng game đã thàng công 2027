            <button onclick="filterCategory('SLOTS')" data-cat="SLOTS" class="cat-tab nav-hex relative z-10 px-3 sm:px-6 py-1.5 sm:py-2 bg-zinc-800 text-yellow-300 font-extrabold text-[11px] sm:text-sm tracking-wider border border-yellow-500/60 hover:bg-zinc-700 transition-transform hover:scale-105">
                SLOTS
