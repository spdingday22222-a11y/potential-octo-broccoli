    <!-- ==================== JAVASCRIPT LOGIC TOÀN DIỆN ==================== -->
    <script>
        // ---------- 1. KHỞI TẠO & LƯU TRỮ TRẠNG THÁI (LOCALSTORAGE) ----------
        const STORAGE_KEY = 'GO88_VIP_STATE_V1';
        const defaultHistory = [
            { id: 101, dice: [5, 3, 5], total: 13, res: 'TAI' },
            { id: 102, dice: [4, 4, 3], total: 11, res: 'TAI' },
            { id: 103, dice: [2, 3, 3], total: 8,  res: 'XIU' },
            { id: 104, dice: [3, 4, 3], total: 10, res: 'XIU' },
            { id: 105, dice: [5, 3, 3], total: 11, res: 'TAI' },
            { id: 106, dice: [5, 3, 4], total: 12, res: 'TAI' },
            { id: 107, dice: [6, 4, 4], total: 14, res: 'TAI' }
        ];

        let state = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {
            username: 'That 123',
            balance: 50000000,
            safeBalance: 0,
            phone: '',
            securityOtp: true,
            avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80',
            historyCC: [...defaultHistory],
            historyMD5: [...defaultHistory],
            myBets: [],
            transactions: [
                { time: 'Hôm nay 18:30', type: 'Tặng Tân Thủ', amount: 50000000, status: 'Thành công' }
            ],
            usedCodes: []
        };

        function saveState() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
            updateGlobalUI();
        }

        function formatMoney(num) {
            return Math.floor(num).toLocaleString('en-US');
        }

        // Âm thanh tổng hợp Web Audio API (không dùng URL ngoài)
        let soundEnabled = true;
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playBeep(freq = 520, duration = 0.08, type = 'sine') {
            if (!soundEnabled) return;
            try {
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.value = freq;
                gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {}
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            document.getElementById('btn-sound').innerHTML = soundEnabled
                ? '<i class="fa-solid fa-volume-high text-sm"></i>'
                : '<i class="fa-solid fa-volume-xmark text-sm text-red-400"></i>';
        }

        function showToast(msg, type = 'success') {
            const container = document.getElementById('toast-container');
            const el = document.createElement('div');
            const colors = {
                success: 'bg-emerald-950/95 border-emerald-400 text-emerald-200',
                error: 'bg-red-950/95 border-red-400 text-red-200',
                info: 'bg-zinc-900/95 border-yellow-400 text-yellow-200'
            };
            el.className = `px-4 py-2.5 rounded-xl border-2 font-bold text-xs sm:text-sm shadow-2xl transition-all duration-300 ${colors[type] || colors.info}`;
            el.innerText = msg;
            container.appendChild(el);
            setTimeout(() => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(-10px)';
                setTimeout(() => el.remove(), 300);
            }, 2200);
        }

        function updateGlobalUI() {
            document.getElementById('footer-username').innerText = state.username;
            document.getElementById('footer-balance').innerText = formatMoney(state.balance);
            document.getElementById('footer-avatar').src = state.avatar;
            document.getElementById('prof-name-display').innerText = state.username;
            document.getElementById('prof-bal-display').innerText = formatMoney(state.balance);
            document.getElementById('prof-preview-img').src = state.avatar;
            document.getElementById('safe-balance-display').innerText = '$ ' + formatMoney(state.safeBalance);

            // Trạng thái SĐT & Rút tiền
            const phoneBadge = document.getElementById('phone-status-badge');
            const wdPhoneStat = document.getElementById('wd-phone-status');
            if (state.phone) {
                phoneBadge.className = 'mt-1 inline-block px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[11px] font-bold';
                phoneBadge.innerText = 'Đã kích hoạt: ' + state.phone;
                wdPhoneStat.className = 'font-black text-emerald-400';
