        // Vẽ 2 biểu đồ đường giống chính xác ảnh 2
        function buildLineCharts(hist) {
            const data = hist.slice(-12);
            if (data.length === 0) return;

            const latest = data[data.length - 1];
            document.getElementById('chart-latest-id').innerText = '#' + String(latest.id).padStart(6, '0');
            document.getElementById('chart-latest-detail').innerText = `${latest.res === 'TAI' ? 'Tài' : 'Xỉu'} ( ${latest.dice.join(' - ')} )`;

            // 1. Biểu đồ tổng điểm (mốc 3, 6, 9, 12, 15, 18)
            const c1 = document.getElementById('canvas-total-chart');
            c1.width = c1.parentElement.clientWidth || 520;
            const ctx1 = c1.getContext('2d');
            ctx1.clearRect(0, 0, c1.width, c1.height);

            const padL = 32, padR = 16, padT = 16, padB = 16;
            const plotW = c1.width - padL - padR;
            const plotH = c1.height - padT - padB;

            // Vẽ lưới mốc 3 -> 18
            const ticks1 = [18, 15, 12, 9, 6, 3];
            ctx1.font = 'bold 11px Inter';
            ctx1.textAlign = 'right';
            ticks1.forEach((val, i) => {
                const y = padT + (i / (ticks1.length - 1)) * plotH;
                ctx1.strokeStyle = 'rgba(34, 197, 94, 0.35)';
                ctx1.lineWidth = 1.5;
                ctx1.beginPath();
                ctx1.moveTo(padL, y);
                ctx1.lineTo(c1.width - padR, y);
                ctx1.stroke();

                ctx1.fillStyle = '#fde047';
                ctx1.fillText(val, padL - 6, y + 4);
            });

            // Nối đường và vẽ chấm tròn xanh lá ghi số điểm
            const stepX = plotW / 11;
            ctx1.strokeStyle = '#d97706';
            ctx1.lineWidth = 2.5;
            ctx1.beginPath();
            data.forEach((item, idx) => {
                const x = padL + idx * stepX + 10;
                const y = padT + ((18 - item.total) / 15) * plotH;
                if (idx === 0) ctx1.moveTo(x, y);
                else ctx1.lineTo(x, y);
            });
            ctx1.stroke();

            data.forEach((item, idx) => {
                const x = padL + idx * stepX + 10;
                const y = padT + ((18 - item.total) / 15) * plotH;
                ctx1.fillStyle = '#16a34a';
                ctx1.beginPath();
                ctx1.arc(x, y, 10, 0, Math.PI * 2);
                ctx1.fill();
                ctx1.strokeStyle = '#ffffff';
                ctx1.lineWidth = 1.5;
                ctx1.stroke();

                ctx1.fillStyle = '#ffffff';
                ctx1.font = 'bold 10px Inter';
                ctx1.textAlign = 'center';
                ctx1.fillText(item.total, x, y + 3.5);
            });

            // 2. Biểu đồ 3 viên xí ngầu (mốc 1 -> 6)
            const c2 = document.getElementById('canvas-dice-chart');
            c2.width = c2.parentElement.clientWidth || 520;
            const ctx2 = c2.getContext('2d');
            ctx2.clearRect(0, 0, c2.width, c2.height);

            const ticks2 = [6, 5, 4, 3, 2, 1];
            ctx2.font = 'bold 11px Inter';
            ctx2.textAlign = 'right';
            ticks2.forEach((val, i) => {
                const y = padT + (i / (ticks2.length - 1)) * plotH;
                ctx2.strokeStyle = 'rgba(180, 83, 9, 0.45)';
                ctx2.lineWidth = 1.5;
                ctx2.beginPath();
                ctx2.moveTo(padL, y);
                ctx2.lineTo(c2.width - padR, y);
                ctx2.stroke();

                ctx2.fillStyle = '#fde047';
                ctx2.fillText(val, padL - 6, y + 4);
            });

            const dieColors = ['#a855f7', '#ef4444', '#22c55e']; // Tím, Đỏ, Xanh lá
            [0, 1, 2].forEach(dIdx => {
                if (!diceLineVisible[dIdx]) return;
                ctx2.strokeStyle = dieColors[dIdx];
                ctx2.lineWidth = 2.5;
                ctx2.beginPath();
                data.forEach((item, idx) => {
                    const x = padL + idx * stepX + 10;
                    const y = padT + ((6 - item.dice[dIdx]) / 5) * plotH;
                    if (idx === 0) ctx2.moveTo(x, y);
                    else ctx2.lineTo(x, y);
                });
                ctx2.stroke();

                data.forEach((item, idx) => {
                    const x = padL + idx * stepX + 10;
                    const y = padT + ((6 - item.dice[dIdx]) / 5) * plotH;
                    ctx2.fillStyle = dieColors[dIdx];
                    ctx2.beginPath();
                    ctx2.arc(x, y, 7, 0, Math.PI * 2);
                    ctx2.fill();
                });
            });
        }

        // ---------- 6. KÉO THẢ MƯỢT MÀ (BÀN CƯỢC, BOT CHAT, MINI GAME) ----------
        function makeDraggable(targetEl, handleEl) {
            let isDown = false, startX = 0, startY = 0, origX = 0, origY = 0;

            function down(e) {
                if (e.target.closest('button') || e.target.closest('input')) return;
                isDown = true;
                const pt = e.touches ? e.touches[0] : e;
                startX = pt.clientX;
                startY = pt.clientY;
                const rect = targetEl.getBoundingClientRect();
                origX = rect.left;
                origY = rect.top;
            }
            function move(e) {
                if (!isDown) return;
                const pt = e.touches ? e.touches[0] : e;
                const nx = Math.max(0, Math.min(window.innerWidth - 80, origX + (pt.clientX - startX)));
                const ny = Math.max(0, Math.min(window.innerHeight - 60, origY + (pt.clientY - startY)));
                targetEl.style.position = 'fixed';
                targetEl.style.left = nx + 'px';
                targetEl.style.top = ny + 'px';
                targetEl.style.right = 'auto';
                targetEl.style.bottom = 'auto';
                targetEl.style.margin = '0';
            }
            function up() { isDown = false; }

            handleEl.addEventListener('mousedown', down);
            window.addEventListener('mousemove', move);
            window.addEventListener('mouseup', up);
            handleEl.addEventListener('touchstart', down, { passive: true });
            window.addEventListener('touchmove', move, { passive: true });
            window.addEventListener('touchend', up);
        }

        makeDraggable(document.getElementById('sicbo-table'), document.getElementById('sicbo-drag-handle'));
