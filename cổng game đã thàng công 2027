        function rollThreeDice() {
            return [
                Math.floor(Math.random() * 6) + 1,
                Math.floor(Math.random() * 6) + 1,
                Math.floor(Math.random() * 6) + 1
            ];
        }

        // Vòng lặp 1 giây cho cả 2 phòng chạy song song
        setInterval(() => {
            ['CANCUA', 'MD5'].forEach(key => {
                const r = rooms[key];
                r.timer--;

                if (r.phase === 'BETTING') {
                    if (r.timer <= 0) {
                        // Chuyển sang 15s NẶN KẾT QUẢ
                        r.phase = 'SQUEEZE';
                        r.timer = 15;
                        r.dice = rollThreeDice();
                        r.revealed = false;
                        // Cân cửa phút chót cho sảnh Cân Cửa
                        if (key === 'CANCUA') {
                            const balanced = Math.min(r.taiTotal, r.xiuTotal);
                            r.taiTotal = balanced;
                            r.xiuTotal = balanced;
                        }
                        if (activeRoomKey === key) {
                            setupSqueezePhaseUI(r);
                        }
                    }
                } else if (r.phase === 'SQUEEZE') {
                    if (activeRoomKey === key && !r.revealed) {
                        document.getElementById('bowl-timer').innerText = r.timer + 's';
                    }
                    if (r.timer <= 0) {
                        // Hết 15s không nặn -> tự động công bố & trả thưởng
                        if (!r.revealed) {
                            finalizeRoomRound(r);
                        }
                        // Reset sang phiên mới với tiền cược 2 bên = 0
                        r.sessionNum++;
                        r.phase = 'BETTING';
                        r.timer = r.betDuration;
                        r.taiTotal = 0;
                        r.xiuTotal = 0;
                        r.taiPlayers = 0;
                        r.xiuPlayers = 0;
                        r.myPlacedTai = 0;
                        r.myPlacedXiu = 0;
                        r.revealed = false;
                        r.md5Hash = generateMd5Mock(r.sessionNum);
                        if (activeRoomKey === key) {
                            resetSicboTableUI(r);
                        }
                    }
                }
            });

            // Cập nhật đồng hồ trên Sảnh chính & Mini Game nổi
            document.getElementById('card-cc-timer').innerText = rooms.CANCUA.phase === 'BETTING' ? rooms.CANCUA.timer + 's' : 'NẶN ' + rooms.CANCUA.timer + 's';
            document.getElementById('card-md5-timer').innerText = rooms.MD5.phase === 'BETTING' ? rooms.MD5.timer + 's' : 'NẶN ' + rooms.MD5.timer + 's';
