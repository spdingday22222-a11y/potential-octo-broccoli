                    CHỌN SẢNH CHƠI
                </div>
            </div>

        </div>
    </main>

    <!-- ==================== 3. FOOTER SẢNH CHÍNH (Dựa trên ảnh 1) ==================== -->
    <footer class="w-full h-16 bg-gradient-to-t from-black via-zinc-900 to-zinc-800 border-t-2 border-yellow-500 flex items-center justify-between px-2 sm:px-4 z-30 shadow-[0_-5px_20px_rgba(0,0,0,0.9)]">
        <!-- Góc trái: Avatar & Tên & Số dư -->
        <div onclick="openModal('modal-profile')" class="flex items-center gap-2 sm:gap-3 cursor-pointer bg-zinc-950/90 border border-yellow-500/60 rounded-full pr-3 sm:pr-5 pl-1 py-1 hover:border-yellow-300 transition">
            <div class="relative">
                <img id="footer-avatar" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80" onerror="this.src='https://placehold.co/100x100/eab308/000000?text=VIP'" class="w-10 h-10 sm:w-11 sm:h-11 rounded-full object-cover border-2 border-yellow-400">
                <span id="footer-vip-badge" class="absolute -bottom-1 -right-1 bg-yellow-500 text-black text-[9px] font-black px-1.5 rounded-full">VIP 1</span>
            </div>
            <div class="leading-tight">
                <div id="footer-username" class="text-xs sm:text-sm font-extrabold text-white truncate max-w-[90px] sm:max-w-[130px]">That 123</div>
                <div class="flex items-center gap-1 text-yellow-400 font-black text-xs sm:text-sm">
