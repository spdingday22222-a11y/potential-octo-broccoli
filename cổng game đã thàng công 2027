                        <div class="dice-cube scale-75">
                            <span class="pip col-start-1 row-start-1"></span>
                            <span class="pip col-start-3 row-start-1"></span>
                            <span class="pip col-start-2 row-start-2"></span>
                            <span class="pip col-start-1 row-start-3"></span>
                            <span class="pip col-start-3 row-start-3"></span>
                        </div>
                    </div>
                </div>
                <div class="text-center font-black text-sm sm:text-base text-yellow-300 drop-shadow">TÀI XỈU MD5</div>
                <!-- Chấm đen trắng + tiền cược giống ảnh 1 -->
                <div class="w-full space-y-1.5 mt-1">
                    <div class="flex items-center gap-2">
                        <span class="w-4 h-4 rounded-full bg-black border-2 border-yellow-500 shrink-0"></span>
                        <div class="flex-1 bg-black/75 border border-sky-400/60 rounded-lg px-2 py-0.5 text-right">
                            <span id="card-md5-tai" class="text-[11px] font-extrabold text-yellow-300">$ 0</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-4 h-4 rounded-full bg-white border-2 border-yellow-500 shrink-0"></span>
                        <div class="flex-1 bg-black/75 border border-sky-400/60 rounded-lg px-2 py-0.5 text-right">
                            <span id="card-md5-xiu" class="text-[11px] font-extrabold text-yellow-300">$ 0</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- THẺ 3: GAME BÀI TIẾN LÊN MIỀN NAM -->
            <div data-group="CARD HOT" onclick="openModal('modal-tienlen')" class="game-card cursor-pointer group relative rounded-2xl bg-gradient-to-b from-emerald-700 via-emerald-950 to-zinc-950 p-3 sm:p-4 border-2 border-yellow-400/80 shadow-xl hover:scale-[1.03] transition-all flex flex-col items-center justify-between min-h-[235px]">
                <div class="w-full flex justify-between items-center text-[11px] font-bold">
                    <span class="bg-black/60 text-emerald-300 px-2 py-0.5 rounded-full">ĐẾM LÁ</span>
                    <span class="text-yellow-400"><i class="fa-solid fa-users"></i> 4 TỤ</span>
                </div>
                <div class="my-3 relative flex items-center justify-center">
                    <div class="w-12 h-16 bg-white rounded-lg border-2 border-yellow-500 text-red-600 font-black p-1 shadow-lg -rotate-12 flex flex-col justify-between text-xs">
                        <span>A♥</span><span class="self-end">♥</span>
