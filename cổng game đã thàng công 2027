            </div>

            <!-- THẺ 2: TÀI XỈU MD5 (Tông tím hoàng gia VIP giống ảnh 1) -->
            <div data-group="HOT LIVE" onclick="openSicboRoom('MD5')" class="game-card cursor-pointer group relative rounded-2xl bg-gradient-to-b from-purple-700 via-fuchsia-900 to-zinc-950 p-3 sm:p-4 border-2 border-yellow-400 shadow-[0_10px_25px_rgba(168,85,247,0.35)] hover:scale-[1.03] transition-all flex flex-col items-center justify-between min-h-[235px]">
                <div class="w-full flex justify-between items-center text-[11px] font-bold">
