            <!-- THẺ 1: TÀI XỈU CÂN CỬA (Tông cam vàng VIP giống ảnh 1) -->
            <div data-group="HOT LIVE" onclick="openSicboRoom('CANCUA')" class="game-card cursor-pointer group relative rounded-2xl bg-gradient-to-b from-orange-500 via-amber-700 to-zinc-950 p-3 sm:p-4 border-2 border-yellow-400 shadow-[0_10px_25px_rgba(249,115,22,0.35)] hover:scale-[1.03] transition-all flex flex-col items-center justify-between min-h-[235px]">
                <div class="w-full flex justify-between items-center text-[11px] font-bold">
                    <span class="bg-black/60 text-yellow-300 px-2 py-0.5 rounded-full border border-yellow-500/40">CÂN CỬA</span>
