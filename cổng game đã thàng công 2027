<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>GO88 VIP - Cổng Game Giải Trí Đẳng Cấp Hoàng Kim</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold-light: #fde047;
            --gold-main: #eab308;
            --gold-dark: #a16207;
            --bg-black: #09090b;
            --panel-black: #121216;
        }
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            font-family: 'Inter', sans-serif;
        }
        body {
            background: radial-gradient(circle at top, #1f1a10 0%, #09090b 55%, #000000 100%);
            color: #f8fafc;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
            margin: 0;
        }
        /* Hiệu ứng chữ vàng kim */
        .gold-text {
            background: linear-gradient(180deg, #fffbeb 0%, #fde047 45%, #d97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));
        }
        .gold-border {
            border: 1.5px solid #eab308;
            box-shadow: 0 0 15px rgba(234, 179, 8, 0.25), inset 0 0 10px rgba(234, 179, 8, 0.1);
        }
        .gold-btn {
            background: linear-gradient(180deg, #fde047 0%, #eab308 50%, #b45309 100%);
            color: #18181b;
            font-weight: 800;
            border: 1px solid #fef08a;
            box-shadow: 0 4px 12px rgba(234, 179, 8, 0.4);
            transition: transform 0.15s, filter 0.15s;
        }
        .gold-btn:active {
            transform: scale(0.95);
        }
        .green-btn {
            background: linear-gradient(180deg, #4ade80 0%, #16a34a 55%, #14532d 100%);
            color: #ffffff;
            font-weight: 800;
            border: 1px solid #86efac;
            box-shadow: 0 4px 15px rgba(34, 197, 94, 0.45);
        }
        /* Hiệu ứng nảy số tiền cược */
        @keyframes moneyBounce {
            0% { transform: scale(1); }
            40% { transform: scale(1.13); color: #fef08a; }
            100% { transform: scale(1); }
        }
        .animate-bounce-num {
            animation: moneyBounce 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        /* Hiệu ứng nháy cửa thắng */
        @keyframes winPulse {
            0%, 100% {
                box-shadow: 0 0 25px #fde047, inset 0 0 20px #eab308;
                border-color: #fef08a;
                transform: scale(1.03);
            }
            50% {
                box-shadow: 0 0 5px #b45309;
                border-color: #78350f;
                transform: scale(0.99);
            }
        }
        .win-glow {
            animation: winPulse 0.65s infinite ease-in-out;
        }
        /* Hiệu ứng cộng tiền bay lên */
        @keyframes floatUpWin {
            0% { opacity: 0; transform: translate(-50%, 10px) scale(0.8); }
            20% { opacity: 1; transform: translate(-50%, -15px) scale(1.15); }
            80% { opacity: 1; transform: translate(-50%, -45px) scale(1); }
            100% { opacity: 0; transform: translate(-50%, -65px) scale(0.9); }
        }
        .win-payout-float {
            animation: floatUpWin 3s forwards ease-out;
        }
        /* Xúc xắc 2.5D sắc nét */
        .dice-cube {
            width: 50px;
            height: 50px;
            background: linear-gradient(145deg, #ffffff 0%, #e2e8f0 75%, #94a3b8 100%);
            border-radius: 11px;
            box-shadow: 0 6px 12px rgba(0,0,0,0.75), inset 0 2px 3px #ffffff, inset 0 -3px 5px rgba(0,0,0,0.3);
            border: 1px solid #cbd5e1;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(3, 1fr);
            padding: 6px;
            position: relative;
        }
        .pip {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #334155, #09090b);
            margin: auto;
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.8);
        }
        .pip.red {
            background: radial-gradient(circle at 30% 30%, #ef4444, #991b1b);
            width: 11px;
            height: 11px;
        }
        /* Bát nặn cứng sang trọng */
        .hard-bowl {
            width: 176px;
            height: 176px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 30%, #3f3f46 0%, #18181b 55%, #09090b 100%);
            border: 4px solid #eab308;
            box-shadow: 0 14px 28px rgba(0,0,0,0.9), inset 0 4px 12px rgba(253, 224, 71, 0.35), inset 0 -8px 16px rgba(0,0,0,0.95);
            cursor: grab;
            touch-action: none;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 30;
        }
        .hard-bowl:active {
            cursor: grabbing;
        }
        /* Thanh cuộn tùy chỉnh */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #09090b;
        }
        ::-webkit-scrollbar-thumb {
            background: #854d0e;
            border-radius: 9999px;
        }
        /* Vòng xoay mini game */
        .mini-orbit-item {
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        /* Tab polygon giống ảnh 1 */
        .nav-hex {
            clip-path: polygon(10% 0%, 90% 0%, 100% 50%, 90% 100%, 10% 100%, 0% 50%);
        }
        .header-trapezoid {
            clip-path: polygon(0 0, 100% 0, 88% 100%, 12% 100%);
        }
    </style>
</head>
<body class="flex flex-col justify-between select-none">

    <!-- THÔNG BÁO TOAST HỆ THỐNG -->
    <div id="toast-container" class="fixed top-16 left-1/2 -translate-x-1/2 z-[9999] flex flex-col items-center gap-2 pointer-events-none"></div>

    <!-- ==================== 1. HEADER SẢNH CHÍNH (GO88) ==================== -->
    <header class="w-full h-14 bg-gradient-to-b from-zinc-900 via-zinc-950 to-black border-b-2 border-yellow-500/80 flex items-center justify-between px-3 sm:px-6 relative z-30 shadow-lg">
