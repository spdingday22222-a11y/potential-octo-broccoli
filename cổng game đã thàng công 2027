            document.getElementById('card-cc-xiu').innerText = '$ ' + formatMoney(rooms.CANCUA.xiuTotal);
            document.getElementById('card-md5-tai').innerText = '$ ' + formatMoney(rooms.MD5.taiTotal);
            document.getElementById('card-md5-xiu').innerText = '$ ' + formatMoney(rooms.MD5.xiuTotal);

            // Hiệu ứng số nảy trên bàn cược đang mở
