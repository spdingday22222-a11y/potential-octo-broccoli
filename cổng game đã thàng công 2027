        // Mini Game nổi: Kéo tự do + Bấm lần 1 bung vòng xoay, bấm lần 2 thu gọn
        (function initFloatingMiniGame() {
            const widget = document.getElementById('floating-minigame');
            const coreBtn = document.getElementById('mini-core-btn');
            const satellites = document.getElementById('minigame-wheel');
            const satBox = document.getElementById('mini-satellites');
            let isExpanded = false;
            let dragged = false;
            let sx = 0, sy = 0, ox = 0, oy = 0, down = false;

            coreBtn.addEventListener('mousedown', startDrag);
            coreBtn.addEventListener('touchstart', startDrag, { passive: true });

            function startDrag(e) {
                down = true;
                dragged = false;
                const pt = e.touches ? e.touches[0] : e;
                sx = pt.clientX; sy = pt.clientY;
                ox = widget.offsetLeft; oy = widget.offsetTop;
            }
            window.addEventListener('mousemove', onDrag);
            window.addEventListener('touchmove', onDrag, { passive: true });
            function onDrag(e) {
                if (!down) return;
                const pt = e.touches ? e.touches[0] : e;
                if (Math.hypot(pt.clientX - sx, pt.clientY - sy) > 6) dragged = true;
                if (dragged) {
                    widget.style.left = Math.max(10, Math.min(window.innerWidth - 75, ox + pt.clientX - sx)) + 'px';
                    widget.style.top = Math.max(10, Math.min(window.innerHeight - 75, oy + pt.clientY - sy)) + 'px';
                }
            }
            window.addEventListener('mouseup', () => down = false);
            window.addEventListener('touchend', () => down = false);

            coreBtn.addEventListener('click', () => {
                if (dragged) return;
                isExpanded = !isExpanded;
                playBeep(isExpanded ? 740 : 480, 0.1);
                if (isExpanded) {
                    satBox.classList.remove('opacity-0', 'scale-50', 'pointer-events-none');
                    satBox.classList.add('opacity-100', 'scale-100', 'rotate-[360deg]');
                } else {
                    satBox.classList.add('opacity-0', 'scale-50', 'pointer-events-none');
                    satBox.classList.remove('opacity-100', 'scale-100', 'rotate-[360deg]');
                }
            });
        })();

