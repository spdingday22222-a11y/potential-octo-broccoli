        // ---------- 2. HỆ THỐNG ĐỘNG CƠ 2 SẢNH TÀI XỈU (CÂN CỬA 40S & MD5 30S) ----------
        function generateMd5Mock(seed) {
            const chars = '0123456789abcdef';
            let hash = '';
            let h = seed * 2654435761;
            for (let i = 0; i < 32; i++) {
                h = (h ^ (h >> 13)) * 1274126177 + i;
                hash += chars[Math.abs(h) % 16];
            }
            return hash;
        }

        const rooms = {
            CANCUA: {
                key: 'CANCUA',
                title: 'TÀI XỈU CÂN CỬA',
                betDuration: 40,
                phase: 'BETTING', // 'BETTING' (40s) | 'SQUEEZE' (15s)
                timer: 40,
                taiTotal: 0,
                xiuTotal: 0,
                taiPlayers: 0,
                xiuPlayers: 0,
                myPlacedTai: 0,
                myPlacedXiu: 0,
                dice: [5, 3, 4],
                revealed: false,
                sessionNum: 108,
                md5Hash: generateMd5Mock(108)
            },
            MD5: {
                key: 'MD5',
                title: 'TÀI XỈU MD5',
                betDuration: 30,
                phase: 'BETTING',
                timer: 30,
                taiTotal: 0,
                xiuTotal: 0,
                taiPlayers: 0,
                xiuPlayers: 0,
                myPlacedTai: 0,
                myPlacedXiu: 0,
