        // Vòng lặp 450ms tăng nảy tiền cược tự động từ 0 lên tới ~2.5 tỷ
        setInterval(() => {
            ['CANCUA', 'MD5'].forEach(key => {
                const r = rooms[key];
                if (r.phase === 'BETTING' && r.timer > 1) {
                    const elapsedRatio = (r.betDuration - r.timer) / r.betDuration;
                    // Tăng lũy tiến từ nhỏ (vài trăm nghìn) lên vài trăm triệu và chạm ngưỡng ~2.48 tỷ
                    const maxCap = 2480000000;
                    const stepBase = elapsedRatio < 0.3 ? 1200000 : (elapsedRatio < 0.7 ? 28000000 : 65000000);
                    const incTai = Math.floor(Math.random() * stepBase) + 150000;
                    const incXiu = Math.floor(Math.random() * stepBase) + 150000;

                    r.taiTotal = Math.min(maxCap, r.taiTotal + incTai);
                    r.xiuTotal = Math.min(maxCap, r.xiuTotal + incXiu);
                    r.taiPlayers += Math.floor(Math.random() * 14) + 1;
                    r.xiuPlayers += Math.floor(Math.random() * 14) + 1;
                }
            });

