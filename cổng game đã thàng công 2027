        // Logic Bảng Cầu 5 hàng ngang - Khi bệt > 5 không rớt xuống dưới mà bẻ ngang sang cột bên cạnh
        function buildBeadRoadGrid(hist) {
            const ROWS = 5;
            const COLS = 16;
            const grid = Array.from({ length: ROWS }, () => Array(COLS).fill(null));

            let col = 0;
            let row = 0;
            let lastRes = null;

            const recent = hist.slice(-45);
            recent.forEach(item => {
                if (lastRes === null) {
                    grid[0][0] = item;
                    lastRes = item.res;
                } else if (item.res === lastRes) {
                    // Đang bệt: nếu chưa chạm đáy 5 hàng và ô dưới trống thì đi xuống
                    if (row + 1 < ROWS && !grid[row + 1][col]) {
                        row++;
                    } else {
                        // Đã chạm đáy hàng 5 -> BẺ NGANG sang cột bên cạnh (hình chữ L)
                        col++;
                    }
                    if (col < COLS) grid[row][col] = item;
                } else {
                    // Đổi cầu (Tài <-> Xỉu): tìm cột trống đầu tiên ở hàng 0
                    lastRes = item.res;
                    row = 0;
                    let nextCol = 0;
                    while (nextCol < COLS && grid[0][nextCol] !== null) {
                        nextCol++;
                    }
                    col = nextCol;
                    if (col < COLS) grid[row][col] = item;
                }
            });

            const container = document.getElementById('bead-road-grid');
            let html = '<table class="border-collapse">';
            for (let r = 0; r < ROWS; r++) {
                html += '<tr>';
                for (let c = 0; c < COLS; c++) {
                    const cell = grid[r][c];
                    html += `<td class="w-9 h-9 sm:w-10 sm:h-10 border-2 border-yellow-600/80 bg-zinc-950 text-center align-middle p-0.5">`;
                    if (cell) {
                        const cls = cell.res === 'TAI'
                            ? 'bg-red-600 border-yellow-300 text-white'
                            : 'bg-sky-500 border-white text-black';
                        html += `<div class="w-7 h-7 sm:w-8 sm:h-8 mx-auto rounded-full border-2 ${cls} flex items-center justify-center text-xs font-black shadow">${cell.total}</div>`;
                    }
                    html += '</td>';
                }
                html += '</tr>';
            }
            html += '</table>';
            container.innerHTML = html;
        }

