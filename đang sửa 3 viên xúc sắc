  <script>
    /* ==========================================
       1. GAME STATE & SYSTEM LOGIC
       ========================================== */
    let balance = 1500000000;
    let currentBetSide = null;
    let tempBetAmount = 0;
    let confirmedBets = { TAI: 0, XIU: 0 };
    
    let timerCountdown = 50;
    let gamePhase = 'BETTING'; // 'BETTING', 'SHAKING', 'REVEAL'
    let isNanMode = false;

    let diceValues = [1, 2, 3];
    let historyResults = [
      { side: 'TAI', total: 14 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 8 },
      { side: 'XIU', total: 6 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 5 },
      { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 },
      { side: 'TAI', total: 15 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 13 }
    ];

    // UI Loading setup
    let loadProgress = 0;
    const loaderFill = document.getElementById('loader-fill');
    const loadInt = setInterval(() => {
      loadProgress += 5;
      loaderFill.style.width = loadProgress + '%';
      if (loadProgress >= 100) {
        clearInterval(loadInt);
        document.getElementById('loading-screen').classList.remove('active');
        document.getElementById('lobby-screen').classList.add('active');
        initThreeJS();
        startGameLoop();
      }
    }, 30);

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);
      onWindowResize();
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      const btn = document.getElementById('btn-nan');
      if (isNanMode) {
        btn.classList.add('active');
        showToast('Đã bật chế độ Nặn 3D (Kéo đĩa/bát úp để mở)');
      } else {
        btn.classList.remove('active');
        showToast('Đã tắt chế độ Nặn');
      }
    }

    function openBetPanel(side) {
      if (gamePhase !== 'BETTING') {
        showToast('Hết thời gian đặt cược!');
        return;
      }
      currentBetSide = side;
      tempBetAmount = 0;
      updateBetDisplay();
      document.getElementById('chip-panel').classList.remove('hidden');
      showToast('Chọn chip để cược cửa ' + side);
    }

    function addChip(val) {
      if (!currentBetSide) return;
      if (tempBetAmount + val > balance) {
        showToast('Số dư không đủ!');
        return;
      }
      tempBetAmount += val;
      updateBetDisplay();
    }

    function allInBet() {
      if (!currentBetSide) return;
      if (balance <= 0) {
        showToast('Số dư bằng 0!');
        return;
      }
      tempBetAmount = balance;
      updateBetDisplay();
      showToast('Đã chọn All-In!');
    }

    function updateBetDisplay() {
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (tempBetAmount > 0) {
          el.innerText = tempBetAmount.toLocaleString();
          el.className = 'bet-text-val active-bet';
        } else {
          el.innerText = '0';
          el.className = 'bet-text-val';
        }
      }
    }

    function cancelBet() {
      showToast('Đã hủy thao tác cược!');
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (confirmedBets[currentBetSide] === 0) {
          el.innerText = 'CƯỢC';
          el.className = 'bet-text-val label-cuoc';
        } else {
          el.innerText = confirmedBets[currentBetSide].toLocaleString();
          el.className = 'bet-text-val active-bet';
        }
      }
      tempBetAmount = 0;
      currentBetSide = null;
      document.getElementById('chip-panel').classList.add('hidden');
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('Chưa chọn số tiền cược!');
        return;
      }

      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;
      
      document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
      document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();
      
      showToast('Đặt ' + tempBetAmount.toLocaleString() + 'đ vào ' + currentBetSide);

      const el = document.getElementById('val-' + currentBetSide);
      el.innerText = confirmedBets[currentBetSide].toLocaleString();
      el.className = 'bet-text-val active-bet';

      document.getElementById('chip-panel').classList.add('hidden');
      tempBetAmount = 0;
      currentBetSide = null;
    }

    /* ==========================================
       2. THREE.JS 3D SCENE SETUP & RENDERER
       ========================================== */
    let scene, camera, renderer, controls;
    let diceMeshes = [];
    let plateCoverMesh;
    let isCoverDragging = false;
    let dragPlane, raycaster, mouseVec;

    // Canvas Texture Generator cho Xúc Xắc Chuẩn Việt Nam
    function createDiceFaceTexture(val) {
      const canvas = document.createElement('canvas');
      canvas.width = 256; canvas.height = 256;
      const ctx = canvas.getContext('2d');

      // Nền mặt xúc xắc màu kem ngà ngọc cao cấp
      ctx.fillStyle = '#f7f4ed';
      ctx.fillRect(0, 0, 256, 256);

      // Viền nhẹ bóng mờ
      ctx.strokeStyle = '#d6ceb8';
      ctx.lineWidth = 8;
      ctx.strokeRect(4, 4, 248, 248);

      // Hàm vẽ chấm tròn 3D
      function drawDot(x, y, radius, color) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(x, y, radius, 0, Math.PI * 2);
        
        // Gradient hiệu ứng chìm của chấm
        let grad = ctx.createRadialGradient(x - radius/3, y - radius/3, radius/4, x, y, radius);
        if (color === 'red') {
          grad.addColorStop(0, '#ff3333');
          grad.addColorStop(0.8, '#cc0000');
          grad.addColorStop(1, '#800000');
        } else { // Xanh đen sắc nét
          grad.addColorStop(0, '#1a365d');
          grad.addColorStop(0.8, '#0f172a');
          grad.addColorStop(1, '#020617');
        }
        
        ctx.fillStyle = grad;
        ctx.shadowColor = 'rgba(0,0,0,0.3)';
        ctx.shadowBlur = 4;
        ctx.shadowOffsetX = 1;
        ctx.shadowOffsetY = 2;
        ctx.fill();
        ctx.restore();
      }

      const c = 128;
      const l = 68;
      const r = 188;
      const t = 68;
      const b = 188;

      if (val === 1) {
        // Mặt 1: Chấm đỏ LỚN ĐẶC TRƯNG
        drawDot(c, c, 38, 'red');
      } else if (val === 2) {
        drawDot(l, t, 20, 'blue');
        drawDot(r, b, 20, 'blue');
      } else if (val === 3) {
        drawDot(l, t, 19, 'blue');
        drawDot(c, c, 19, 'blue');
        drawDot(r, b, 19, 'blue');
      } else if (val === 4) {
        // Mặt 4: 4 Chấm đỏ ĐẶC TRƯNG TÀI XỈU VIỆT NAM
        drawDot(l, t, 20, 'red');
        drawDot(r, t, 20, 'red');
        drawDot(l, b, 20, 'red');
        drawDot(r, b, 20, 'red');
      } else if (val === 5) {
        drawDot(l, t, 19, 'blue');
        drawDot(r, t, 19, 'blue');
        drawDot(c, c, 19, 'blue');
        drawDot(l, b, 19, 'blue');
        drawDot(r, b, 19, 'blue');
      } else if (val === 6) {
        drawDot(l, t, 18, 'blue');
        drawDot(r, t, 18, 'blue');
        drawDot(l, c, 18, 'blue');
        drawDot(r, c, 18, 'blue');
        drawDot(l, b, 18, 'blue');
        drawDot(r, b, 18, 'blue');
      }

      const texture = new THREE.CanvasTexture(canvas);
      texture.needsUpdate = true;
      return texture;
    }

    function initThreeJS() {
      const container = document.getElementById('three-canvas-container');
      const width = container.clientWidth || 250;
      const height = container.clientHeight || 250;

      // 1. Scene
      scene = new THREE.Scene();

      // 2. Camera nghiêng phác thảo chuẩn
      camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
      camera.position.set(0, 18, 16);

      // 3. Renderer
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      container.appendChild(renderer.domElement);

      // 4. OrbitControls xoay đĩa linh hoạt
      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.05;
      controls.maxPolarAngle = Math.PI / 2 - 0.05; // Không xoay xuống dưới đĩa
      controls.minDistance = 10;
      controls.maxDistance = 30;

      // 5. Ánh sáng
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xfff5ea, 1.2);
      dirLight.position.set(10, 20, 10);
      dirLight.castShadow = true;
      dirLight.shadow.mapSize.width = 1024;
      dirLight.shadow.mapSize.height = 1024;
      scene.add(dirLight);

      const pointLight = new THREE.PointLight(0xffb703, 0.8, 20);
      pointLight.position.set(0, 8, 0);
      scene.add(pointLight);

      // 6. Đĩa Tròn 3D Center-Plate
      const plateGeo = new THREE.CylinderGeometry(6, 4.8, 0.6, 64);
      const plateMat = new THREE.MeshStandardMaterial({
        color: 0x1f1915,
        roughness: 0.3,
        metalness: 0.7
      });
      const plateMesh = new THREE.Mesh(plateGeo, plateMat);
      plateMesh.position.y = -0.3;
      plateMesh.receiveShadow = true;
      scene.add(plateMesh);

      // Lòng đĩa màu đỏ mận sâu
      const innerPlateGeo = new THREE.CylinderGeometry(5.4, 5.4, 0.05, 64);
      const innerPlateMat = new THREE.MeshStandardMaterial({
        color: 0x5a0606,
        roughness: 0.5
      });
      const innerPlateMesh = new THREE.Mesh(innerPlateGeo, innerPlateMat);
      innerPlateMesh.position.y = 0.01;
      innerPlateMesh.receiveShadow = true;
      scene.add(innerPlateMesh);

      // Viền vàng đĩa
      const rimGeo = new THREE.TorusGeometry(5.7, 0.2, 16, 64);
      const rimMat = new THREE.MeshStandardMaterial({ color: 0xffb703, metalness: 0.9, roughness: 0.2 });
      const rimMesh = new THREE.Mesh(rimGeo, rimMat);
      rimMesh.rotation.x = Math.PI / 2;
      rimMesh.position.y = 0.02;
      scene.add(rimMesh);

      // 7. Tạo 3 Viên Xúc Xắc 3D Khối Bo Góc (Standard Cube)
      // Tạo Texture cho 6 mặt: 右(1), 左(6), 上(2), 下(5), 前(3), 後(4)
      const materialsVal = [
        new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(1), roughness: 0.2 }), // Right
        new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(6), roughness: 0.2 }), // Left
        new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(2), roughness: 0.2 }), // Top
        new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(5), roughness: 0.2 }), // Bottom
        new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(3), roughness: 0.2 }), // Front
        new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(4), roughness: 0.2 })  // Back
      ];

      const diceGeo = new THREE.BoxGeometry(1.6, 1.6, 1.6);

      const positions = [
        { x: -1.3, z: 0.6 },
        { x: 1.3, z: 0.6 },
        { x: 0, z: -1.4 }
      ];

      for (let i = 0; i < 3; i++) {
        const dice = new THREE.Mesh(diceGeo, materialsVal);
        dice.position.set(positions[i].x, 0.85, positions[i].z);
        dice.castShadow = true;
        dice.receiveShadow = true;
        scene.add(dice);
        diceMeshes.push(dice);
      }

      // 8. Bát Úp 3D Mạ Vàng VIP (Plate Cover)
      const coverGeo = new THREE.SphereGeometry(5.5, 32, 16, 0, Math.PI * 2, 0, Math.PI / 2);
      const coverMat = new THREE.MeshStandardMaterial({
        color: 0x221c16,
        metalness: 0.8,
        roughness: 0.2,
        side: THREE.DoubleSide
      });
      plateCoverMesh = new THREE.Mesh(coverGeo, coverMat);
      plateCoverMesh.position.set(0, 0, 0);
      plateCoverMesh.castShadow = true;
      scene.add(plateCoverMesh);

      // Núm bát úp
      const knobGeo = new THREE.SphereGeometry(0.8, 16, 16);
      const knobMat = new THREE.MeshStandardMaterial({ color: 0xffb703, metalness: 0.9, roughness: 0.1 });
      const knobMesh = new THREE.Mesh(knobGeo, knobMat);
      knobMesh.position.y = 5.6;
      plateCoverMesh.add(knobMesh);

      // 9. Raycasting cho thao tác Nặn Bát Úp 3D
      raycaster = new THREE.Raycaster();
      mouseVec = new THREE.Vector2();
      dragPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);

      setupCoverDragListeners(renderer.domElement);

      window.addEventListener('resize', onWindowResize);
      animateThree();
    }

    function onWindowResize() {
      if (!renderer || !camera) return;
      const container = document.getElementById('three-canvas-container');
      const w = container.clientWidth;
      const h = container.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }

    function animateThree() {
      requestAnimationFrame(animateThree);
      controls.update();

      // Hiệu ứng lắc 3D cho xúc xắc
      if (gamePhase === 'SHAKING') {
        diceMeshes.forEach((dice, idx) => {
          dice.rotation.x += 0.3 + idx * 0.1;
          dice.rotation.y += 0.4 + idx * 0.05;
          dice.rotation.z += 0.2;
          dice.position.y = 0.85 + Math.abs(Math.sin(Date.now() * 0.02 + idx)) * 1.5;
        });
      }

      renderer.render(scene, camera);
    }

    /* ==========================================
       3. XOAY HƯỚNG MẶT XÚC XẮC CHÍNH XÁC KHI KẾT QUẢ RA
       ========================================== */
    function setDiceResultRotation(diceMesh, val) {
      // Thiết lập góc xoay chuẩn để mặt tương ứng hướng lên trên (+Y)
      // Right(1), Left(6), Top(2), Bottom(5), Front(3), Back(4)
      const rotMap = {
        1: { x: 0, z: -Math.PI / 2 },
        2: { x: 0, z: 0 },
        3: { x: Math.PI / 2, z: 0 },
        4: { x: -Math.PI / 2, z: 0 },
        5: { x: Math.PI, z: 0 },
        6: { x: 0, z: Math.PI / 2 }
      };

      const target = rotMap[val] || { x: 0, z: 0 };
      diceMesh.rotation.set(target.x, (Math.random() - 0.5) * 0.5, target.z);
      diceMesh.position.y = 0.85;
    }

    /* ==========================================
       4. KÉO THẢ NẶN BÁT ÚP 3D (TOUCH & MOUSE)
       ========================================== */
    function setupCoverDragListeners(domElem) {
      const getIntersectPlanePoint = (e) => {
        const rect = domElem.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        mouseVec.x = ((clientX - rect.left) / rect.width) * 2 - 1;
        mouseVec.y = -((clientY - rect.top) / rect.height) * 2 + 1;

        raycaster.setFromCamera(mouseVec, camera);
        const target = new THREE.Vector3();
        raycaster.ray.intersectPlane(dragPlane, target);
        return target;
      };

      const onStart = (e) => {
        if (!isNanMode || gamePhase === 'SHAKING') return;
        isCoverDragging = true;
        controls.enabled = false; // Tắt xoay góc nhìn camera khi đang nặn bát
      };

      const onMove = (e) => {
        if (!isCoverDragging || !plateCoverMesh) return;
        const pt = getIntersectPlanePoint(e);
        if (pt) {
          plateCoverMesh.position.x = pt.x;
          plateCoverMesh.position.z = pt.z;

          // Nếu kéo bát ra xa đĩa quá 4 unit -> Tự mở kết quả
          const dist = Math.hypot(pt.x, pt.z);
          if (dist > 4.5 && gamePhase === 'REVEAL') {
            revealResultFully();
          }
        }
      };

      const onEnd = () => {
        isCoverDragging = false;
        controls.enabled = true;
      };

      domElem.addEventListener('mousedown', onStart);
      domElem.addEventListener('mousemove', onMove);
      window.addEventListener('mouseup', onEnd);

      domElem.addEventListener('touchstart', onStart, { passive: true });
      domElem.addEventListener('touchmove', onMove, { passive: true });
      window.addEventListener('touchend', onEnd);
    }

    function revealResultFully() {
      plateCoverMesh.position.set(0, 15, 0); // Đẩy bát lên cao khỏi đĩa
    }

    /* ==========================================
       5. GAME LOOP ĐỒNG BỘ THỜI GIAN THỰC
       ========================================== */
    function startGameLoop() {
      setInterval(() => {
        timerCountdown--;

        const timerEl = document.getElementById('timer-text');
        if (timerEl) timerEl.innerText = timerCountdown;

        if (timerCountdown === 10 && gamePhase === 'BETTING') {
          // Khóa cược, chuyển sang Lắc Xúc Xắc 3D
          gamePhase = 'SHAKING';
          showToast('Hết giờ cược! Đang lắc xúc xắc 3D...');
          plateCoverMesh.position.set(0, 0, 0); // Úp bát

          // Tạo ngẫu nhiên kết quả 3 viên xúc xắc
          diceValues = [
            Math.floor(Math.random() * 6) + 1,
            Math.floor(Math.random() * 6) + 1,
            Math.floor(Math.random() * 6) + 1
          ];

          // Lắc 3D trong 2.5 giây
          setTimeout(() => {
            gamePhase = 'REVEAL';
            // Đặt góc xoay chính xác cho 3 viên xúc xắc
            diceMeshes.forEach((dice, idx) => setDiceResultRotation(dice, diceValues[idx]));

            if (!isNanMode) {
              revealResultFully();
              processWinResult();
            } else {
              showToast('Hãy dùng tay vuốt nặn bát úp 3D!');
            }
          }, 2500);
        }

        if (timerCountdown <= 0) {
          // Reset phiên mới
          timerCountdown = 50;
          gamePhase = 'BETTING';
          confirmedBets = { TAI: 0, XIU: 0 };
          document.getElementById('val-TAI').innerText = 'CƯỢC';
          document.getElementById('val-TAI').className = 'bet-text-val label-cuoc';
          document.getElementById('val-XIU').innerText = 'CƯỢC';
          document.getElementById('val-XIU').className = 'bet-text-val label-cuoc';
          document.getElementById('win-overlay').style.display = 'none';
          document.getElementById('title-TAI').classList.remove('highlight-pulse');
          document.getElementById('title-XIU').classList.remove('highlight-pulse');

          plateCoverMesh.position.set(0, 0, 0); // Reset bát úp
          showToast('Bắt đầu phiên cược mới!');
        }
      }, 1000);
    }

    function processWinResult() {
      const sum = diceValues.reduce((a, b) => a + b, 0);
      const resSide = sum >= 11 ? 'TAI' : 'XIU';

      historyResults.unshift({ side: resSide, total: sum });
      if (historyResults.length > 50) historyResults.pop();

      // Hiển thị Win Title Pulsing
      document.getElementById('title-' + resSide).classList.add('highlight-pulse');

      let winAmt = 0;
      if (confirmedBets[resSide] > 0) {
        winAmt = confirmedBets[resSide] * 1.98;
        balance += winAmt;
        document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
        document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();

        const winEl = document.getElementById('win-overlay');
        winEl.innerText = '+' + winAmt.toLocaleString();
        winEl.style.display = 'block';
        showToast('Chúc mừng! Bạn thắng ' + winAmt.toLocaleString() + 'đ');
      } else {
        showToast('Kết quả: ' + sum + ' điểm - ' + resSide);
      }
    }

    /* ==========================================
       6. SOI CẦU GRID MODAL
       ========================================== */
    function openChartModal() {
      const gridContainer = document.getElementById('grid-cau');
      gridContainer.innerHTML = '';

      historyResults.forEach(res => {
        const cell = document.createElement('div');
        cell.className = 'grid-cell';

        const dot = document.createElement('div');
        dot.className = 'dot-result ' + (res.side === 'TAI' ? 'tai' : 'xiu');
        dot.innerText = res.total;

        cell.appendChild(dot);
        gridContainer.appendChild(cell);
      });

      document.getElementById('chart-modal').classList.add('active');
    }

    function closeChartModal() {
      document.getElementById('chart-modal').classList.remove('active');
    }
  </script>
