<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cổng Game Go88 Real - Tài Xỉu 3D MD5 VIP</title>
  
  <!-- Thư viện Three.js & OrbitControls -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

  <style>
    /* Reset & Base UI Styling */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      font-family: 'Arial Black', 'Arial', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #020204;
      color: #ffffff;
      overflow: hidden;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app-screen {
      position: absolute;
      top: 0; left: 0; width: 100vw; height: 100vh;
      display: none; opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
    }

    .app-screen.active {
      display: flex; opacity: 1; z-index: 10;
    }

    /* 1. LOADING SCREEN */
    #loading-screen {
      background: radial-gradient(circle, #101018 0%, #020204 100%);
      flex-direction: column; justify-content: center; align-items: center;
      z-index: 9999;
    }

    .loader-brand {
      font-size: 38px; font-weight: 900;
      background: linear-gradient(180deg, #ffffff 0%, #ffaa00 50%, #e65c00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 20px rgba(255, 170, 0, 0.6));
      letter-spacing: 2px; text-transform: uppercase;
    }

    .loader-box {
      width: 320px; height: 14px; background: rgba(0,0,0,0.9);
      border: 1.5px solid #ffb703; border-radius: 10px; padding: 2px; margin-top: 20px;
      box-shadow: 0 0 15px rgba(255, 183, 3, 0.3);
    }

    .loader-fill {
      height: 100%; width: 0%;
      background: linear-gradient(90deg, #ff8000, #ffea00);
      border-radius: 10px; transition: width 0.05s linear;
      box-shadow: 0 0 10px #ffea00;
    }

    /* 2. GAME LOBBY */
    .game-lobby {
      position: relative; width: 100vw; height: 100vh;
      background: radial-gradient(circle at center, #1a1005 0%, #080402 50%, #000000 100%);
      display: flex; flex-direction: column; justify-content: space-between;
    }

    .top-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 24px; background: rgba(15, 12, 10, 0.95);
      border-bottom: 2px solid #2d1f10; z-index: 20;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
    }

    .user-info { display: flex; align-items: center; gap: 12px; }
    .avatar { width: 44px; height: 44px; border-radius: 10px; border: 2px solid #ffaa00; background-size: cover; box-shadow: 0 0 10px rgba(255,170,0,0.5); }
    .balance-box {
      background: #08080c; border: 1.5px solid #ffb703;
      border-radius: 18px; padding: 4px 16px; color: #ffea00;
      font-weight: bold; font-size: 15px; text-shadow: 0 0 8px rgba(255, 234, 0, 0.5);
      box-shadow: inset 0 0 6px rgba(0,0,0,0.8);
    }

    .lobby-content { display: flex; justify-content: center; align-items: center; gap: 30px; flex: 1; }

    .game-card {
      width: 230px; height: 290px; border-radius: 20px; border: 2px solid #ffaa00;
      display: flex; flex-direction: column; justify-content: space-between; padding: 20px;
      cursor: pointer; transition: transform 0.25s, box-shadow 0.25s;
      background: linear-gradient(180deg, #3a1c06 0%, #0a0501 100%);
      box-shadow: 0 0 30px rgba(255, 170, 0, 0.3), inset 0 0 15px rgba(255, 255, 255, 0.1);
    }
    .game-card:hover { transform: translateY(-8px) scale(1.04); box-shadow: 0 0 45px rgba(255, 170, 0, 0.7); }

    .card-title {
      font-size: 22px; font-weight: 900; text-align: center;
      background: linear-gradient(180deg, #ffffff 0%, #ffaa00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));
    }
    .card-sub { font-size: 12px; text-align: center; color: #00ffcc; font-weight: bold; letter-spacing: 1px; }

    /* 3. ARENA GAME PLAY */
    .arena-screen {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(2, 2, 5, 0.98); z-index: 100; display: none;
      flex-direction: column; justify-content: space-between;
    }

    .arena-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 24px; background: rgba(10, 10, 15, 0.98); border-bottom: 1.5px solid #2d1f10;
      z-index: 20; box-shadow: 0 4px 15px rgba(0,0,0,0.8);
    }

    .btn-back-lobby {
      background: linear-gradient(180deg, #80000a, #4a0005);
      border: 1px solid #ff4d4d; border-radius: 12px; color: #fff;
      padding: 6px 14px; font-weight: bold; cursor: pointer;
    }

    .arena-stage { flex: 1; display: flex; justify-content: center; align-items: center; position: relative; }

    .real-taixiu-board {
      position: absolute; width: 780px; height: 380px;
      border-radius: 190px; display: flex; justify-content: space-between; align-items: center;
      padding: 20px 40px;
      background: radial-gradient(circle at center, #520808 0%, #300303 60%, #170101 100%);
      border: 4px solid #ffb703;
      box-shadow: 0 0 60px rgba(255, 183, 3, 0.4), inset 0 0 30px rgba(0, 0, 0, 0.9);
      touch-action: none;
    }

    .board-logo {
      position: absolute; top: 16px; left: 50%; transform: translateX(-50%);
      font-size: 16px; font-weight: 900; letter-spacing: 2px;
      background: linear-gradient(180deg, #ffea00 0%, #ff8000 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 8px rgba(255, 234, 0, 0.8));
      z-index: 5; pointer-events: none;
    }

    .circle-btn {
      position: absolute; width: 36px; height: 36px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center; color: #fff;
      font-size: 14px; font-weight: bold; cursor: pointer;
      background: linear-gradient(180deg, #2a2a38, #1e1e1f);
      border: 1.5px solid #ffb703; z-index: 15; box-shadow: 0 4px 8px #000;
      transition: transform 0.15s;
    }
    .circle-btn:active { transform: scale(0.9); }

    .btn-info { top: 22px; left: 145px; }
    .btn-chart { top: 88px; left: 60px; background: linear-gradient(180deg, #0077b6, #023e8a); }
    .btn-help { top: 158px; left: 25px; }
    .btn-history { top: 228px; left: 60px; }

    .btn-close { top: 22px; right: 145px; background: linear-gradient(180deg, #9e1a22, #500000); }
    .btn-rank { top: 88px; right: 60px; }
    .btn-chat-toggle { top: 158px; right: 25px; }

    .btn-nan-hand {
      position: absolute; right: 105px; bottom: 25px; width: 46px; height: 46px;
      border-radius: 50%; background: radial-gradient(circle, #352500, #140d00);
      border: 2px solid #ffea00; box-shadow: 0 0 12px #ffb703;
      display: flex; justify-content: center; align-items: center; font-size: 22px;
      cursor: pointer; z-index: 16; transition: transform 0.2s, background 0.3s;
    }
    .btn-nan-hand.active { background: radial-gradient(circle, #005f73, #0a9396); border-color: #00ffcc; box-shadow: 0 0 18px #00ffcc; }

    .bet-side {
      width: 200px; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 10;
    }

    .player-count {
      font-size: 13px; color: #ffb703; font-weight: bold; margin-bottom: 2px;
      text-shadow: 0 0 5px #000;
    }

    .bet-title {
      font-size: 58px; font-weight: 900; color: #e6e6e6;
      text-shadow: 0 4px 10px rgba(0, 0, 0, 0.9);
      letter-spacing: 3px; transition: all 0.3s ease;
    }
    .bet-title.highlight-pulse {
      color: #ffea00; text-shadow: 0 0 25px #ffea00, 0 0 50px #ff8000;
      animation: pulseGlow 0.6s infinite alternate;
    }
    @keyframes pulseGlow {
      from { transform: scale(1); }
      to { transform: scale(1.12); }
    }

    .bet-amount {
      font-size: 18px; font-weight: 900; color: #00ffcc;
      text-shadow: 0 0 8px rgba(0, 255, 204, 0.6); margin-bottom: 8px;
    }

    .btn-cuoc-oval {
      width: 145px; height: 40px;
      background: radial-gradient(circle, #2a1a08 0%, #120b03 100%);
      border: 2px solid #ffb703; border-radius: 20px;
      display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: inset 0 0 8px rgba(0,0,0,0.9), 0 4px 10px rgba(0,0,0,0.8);
      transition: transform 0.1s, border-color 0.2s;
    }
    .btn-cuoc-oval:active { transform: scale(0.95); }

    .bet-text-val { font-size: 16px; font-weight: 900; color: #f0b105; text-shadow: 0 1px 2px #000; }
    .bet-text-val.label-cuoc {
      color: #ffffff;
      font-size: 18px; letter-spacing: 1px;
    }
    .bet-text-val.active-bet { color: #00ffcc; text-shadow: 0 0 8px rgba(0, 255, 204, 0.9); }

    /* KHU VỰC 3D THREE.JS CONTAINER */
    .center-plate-3d-wrapper {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: 250px; height: 250px; border-radius: 50%;
      z-index: 12; overflow: visible;
    }

    #three-canvas-container {
      width: 100%; height: 100%;
      border-radius: 50%;
      cursor: grab;
      touch-action: none;
    }
    #three-canvas-container:active { cursor: grabbing; }

    .timer-display {
      position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
      font-size: 42px; font-weight: 900; color: #00ffcc;
      text-shadow: 0 0 15px rgba(0,255,204,0.9), 0 0 5px #000;
      z-index: 20; pointer-events: none;
    }

    .win-text-overlay {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      font-size: 36px; font-weight: 900; color: #ffea00;
      text-shadow: 0 0 20px #ffea00, 0 4px 10px #000; z-index: 30; display: none; white-space: nowrap;
      animation: popWin 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      pointer-events: none;
    }
    @keyframes popWin {
      0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
      100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }

    /* CHIP PANEL */
    .chip-panel-real {
      position: absolute; bottom: 10px; left: 50%;
      transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 8px;
      padding: 10px 24px; border-radius: 16px; z-index: 100;
      background: rgba(10, 8, 5, 0.9); border: 1.5px solid #ffb703;
      box-shadow: 0 0 25px rgba(0,0,0,0.9);
      transition: opacity 0.35s ease, transform 0.35s ease;
      opacity: 1;
    }

    .chip-panel-real.hidden {
      opacity: 0; pointer-events: none;
      transform: translate(-50%, 50px);
    }

    .chip-list { display: flex; gap: 8px; }

    .chip-btn {
      width: 58px; height: 38px; border-radius: 8px;
      background: linear-gradient(180deg, #3a2205 0%, #1f1101 100%);
      border: 1.5px solid #ffea00; color: #ffffff; font-size: 13px; font-weight: 900;
      display: flex; justify-content: center; align-items: center; cursor: pointer;
      box-shadow: 0 4px 8px #000;
      transition: transform 0.1s, box-shadow 0.1s;
    }
    .chip-btn:active { transform: translateY(-2px); box-shadow: 0 0 12px #ffea00; }

    .chip-actions { display: flex; gap: 12px; width: 100%; justify-content: center; margin-top: 2px; }

    .btn-action-x2 {
      background: linear-gradient(180deg, #2e2e2e, #3a6073); border: 1px solid #3f3f3f;
      color: #e0dede; padding: 6px 20px; border-radius: 18px; font-weight: 900; font-size: 13px; cursor: pointer;
      box-shadow: 0 3px 6px rgba(0,0,0,0.6);
    }

    .btn-action-bet {
      background: linear-gradient(180deg, #ffaa00 0%, #e65c00 100%);
      border: 1.5px solid #ffffff;
      color: #000; padding: 6px 32px; border-radius: 18px; font-weight: 900; font-size: 14px; cursor: pointer;
      box-shadow: 0 0 15px rgba(255,170,0,0.6);
    }

    .btn-action-cancel {
      background: linear-gradient(180deg, #68272d 0%, #801e23 60%, #801313 100%);
      border: 1.5px solid #dad7da;
      color: #fff; padding: 6px 20px; border-radius: 18px; font-weight: 900; font-size: 13px; cursor: pointer;
      box-shadow: 0 3px 6px rgba(0,0,0,0.8);
    }

    /* MODAL SOI CẦU */
    .chart-modal-overlay {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(0, 0, 0, 0.85); z-index: 1000; display: none;
      justify-content: center; align-items: center; backdrop-filter: blur(4px);
    }
    .chart-modal-overlay.active { display: flex; }

    .chart-modal-box {
      width: 820px; height: 450px;
      background: linear-gradient(180deg, #1c140d 0%, #080503 100%);
      border: 2.5px solid #ffb703; border-radius: 20px;
      box-shadow: 0 0 50px rgba(255, 183, 3, 0.4);
      display: flex; flex-direction: column; overflow: hidden; position: relative;
    }

    .chart-header {
      height: 48px; background: linear-gradient(180deg, #3d2914, #1f1408);
      border-bottom: 2px solid #ffb703; display: flex; justify-content: space-between;
      align-items: center; padding: 0 20px;
    }

    .chart-title {
      font-size: 16px; font-weight: 900; color: #ffea00;
      text-shadow: 0 2px 4px #000; letter-spacing: 1px;
    }

    .btn-close-chart {
      width: 28px; height: 28px; border-radius: 50%; background: #9e1a22; border: 1.5px solid #fff;
      color: #fff; font-weight: bold; display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: 0 2px 4px #000;
    }

    .chart-body-wrapper {
      flex: 1; padding: 15px; overflow-x: auto; overflow-y: hidden;
      display: flex; flex-direction: column; gap: 12px;
    }

    .grid-cau-container {
      display: grid;
      grid-template-rows: repeat(5, 42px);
      grid-auto-columns: 42px;
      grid-auto-flow: column;
      gap: 3px;
      background: #120c06;
      border: 2px solid #ffb703;
      padding: 6px;
      border-radius: 8px;
      width: max-content;
      min-width: 100%;
    }

    .grid-cell {
      width: 42px; height: 42px;
      background: #1f160e;
      border: 1px solid #3d2914;
      display: flex; justify-content: center; align-items: center;
      border-radius: 4px;
    }

    .dot-result {
      width: 32px; height: 32px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center;
      font-size: 13px; font-weight: 900; color: #ffffff;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.8);
    }
    .dot-result.tai {
      background: radial-gradient(circle at 35% 35%, #2c2c2c, #000000);
      border: 1.5px solid #ffea00; color: #ffea00; text-shadow: 0 0 2px #000;
    }
    .dot-result.xiu {
      background: radial-gradient(circle at 35% 35%, #ffffff, #dcdcdc);
      border: 1.5px solid #000; color: #000;
    }

    /* TOAST NOTIFICATION */
    .toast-msg {
      position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-50px);
      background: rgba(30, 20, 10, 0.95); border: 2px solid #ffb703; color: #ffea00;
      padding: 10px 24px; border-radius: 20px; font-weight: bold; font-size: 13px;
      z-index: 9999; opacity: 0; transition: all 0.3s ease; pointer-events: none;
      box-shadow: 0 0 20px rgba(255,183,3,0.5);
    }
    .toast-msg.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  </style>
</head>
<body>

