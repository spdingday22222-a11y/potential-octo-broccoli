document.addEventListener("DOMContentLoaded", () => {
    // 1. Particle Background System
    const canvas = document.getElementById('bg-canvas');
    if (canvas) {
        const ctx = canvas.getContext('2d');
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        const particles = Array.from({ length: 60 }, () => ({
            x: Math.random() * width,
            y: Math.random() * height,
            size: Math.random() * 2.5 + 0.5,
            speedY: - (Math.random() * 0.8 + 0.2),
            speedX: (Math.random() - 0.5) * 0.3,
            opacity: Math.random() * 0.7 + 0.3
        }));

        function renderParticles() {
            ctx.clearRect(0, 0, width, height);
            particles.forEach(p => {
                p.y += p.speedY;
                p.x += p.speedX;

                if (p.y < 0) {
                    p.y = height;
                    p.x = Math.random() * width;
                }

                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(255, 215, 0, ${p.opacity})`;
                ctx.shadowBlur = 8;
                ctx.shadowColor = "#ffd700";
                ctx.fill();
            });
            requestAnimationFrame(renderParticles);
        }
        renderParticles();
    }

    // 2. Interactive 3D Parallax Tilt Effect
    const stage = document.getElementById('stage');
    const container = document.querySelector('.game-container');

    if (stage && container) {
        stage.addEventListener('mousemove', (e) => {
            const rect = stage.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;

            const rotateX = (-y / rect.height) * 12; // Tilt góc X
            const rotateY = (x / rect.width) * 12;  // Tilt góc Y

            container.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });

        stage.addEventListener('mouseleave', () => {
            container.style.transform = `rotateX(0deg) rotateY(0deg)`;
        });
    }

    // 3. Real-Time Dynamic Jackpot Counter
    function animateJackpot(id, baseValue) {
        const el = document.getElementById(id);
        if (!el) return;

        setInterval(() => {
            baseValue += Math.floor(Math.random() * 150) + 10;
            el.innerText = "$ " + baseValue.toLocaleString('en-US');
        }, 2000);
    }

    animateJackpot('jackpot1', 25541283);
    animateJackpot('jackpot2', 517552830);
    animateJackpot('jackpot3', 658389138);
});

