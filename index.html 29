        function id(name) { return document.getElementById(name); }

        // --- DYNAMIC RESPONSIVE AUTO-SCALING ENGINE (Tỉ lệ chuẩn 16:9) ---
        function scaleStage() {
            const stage = id('stage');
            const targetWidth = 1120;
            const targetHeight = 630;
            const windowWidth = window.innerWidth;
            const windowHeight = window.innerHeight;

            const scaleX = windowWidth / targetWidth;
            const scaleY = windowHeight / targetHeight;
            const scale = Math.min(scaleX, scaleY) * 0.96; // Giữ lề 96% màn hình

            stage.style.transform = `scale(${scale})`;
        }
        window.addEventListener('resize', scaleStage);
        scaleStage();

        // --- BACKGROUND PARTICLES CANVAS ---
        const canvas = id('bg-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() { this.reset(); }
            reset() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2.5 + 0.8;
                this.speedX = (Math.random() - 0.5) * 0.4;
                this.speedY = (Math.random() - 0.5) * 0.4;
                this.opacity = Math.random() * 0.7 + 0.2;
                this.color = Math.random() > 0.4 ? '#ffd700' : '#ff9900';
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;
                if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height) {
                    this.reset();
                }
            }
            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.globalAlpha = this.opacity;
                ctx.fill();
            }
        }

        for (let i = 0; i < 75; i++) particles.push(new Particle());

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => { p.update(); p.draw(); });
            requestAnimationFrame(animateParticles);
        }
        animateParticles();

        // --- DYNAMIC JACKPOT TICKER ---
        function animateValue(idName, duration) {
            setInterval(() => {
                let obj = id(idName);
                if(!obj) return;
                let current = parseInt(obj.innerText.replace(/[^0-9]/g, ''));
                let increment = Math.floor(Math.random() * 60000) + 15000;
                let target = current + increment;
                obj.innerText = "$ " + target.toLocaleString('en-US');
            }, duration);
        }

        animateValue('jackpot1', 2200);
