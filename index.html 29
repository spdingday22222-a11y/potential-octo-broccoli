<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Go88 - Cổng Game Bài Đổi Thưởng Premium 3D</title>
    <style>
        :root {
            --gold-light: #fff5a6;
            --gold-primary: #ffd700;
            --gold-secondary: #d4af37;
            --gold-dark: #6e4e00;
            --bg-dark: #040201;
            --red-glow: #ff2a2a;
            --cyan-glow: #00ffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Montserrat', 'Segoe UI', Arial, sans-serif;
            user-select: none;
        }

        body {
            background-color: var(--bg-dark);
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
            position: relative;
        }

        /* Canvas Hạt Sáng Nền */
        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 1;
            pointer-events: none;
        }

        /* Dynamic Responsive Scaling Engine Container (Ratio 16:9) */
        .stage-wrapper {
            position: relative;
            z-index: 2;
            width: 1120px;
            height: 630px;
            display: flex;
            justify-content: center;
            align-items: center;
            perspective: 1200px; /* Góc nhìn 3D toàn cảnh sòng bài */
            transform-origin: center center;
        }

        /* Khung Game Chính - Metallic Gold Border 3D Multi-Layer */
        .game-container {
            width: 1120px;
            height: 630px;
            background: radial-gradient(circle at 50% 25%, #3a200a 0%, #170a03 55%, #050201 100%);
            border-radius: 24px;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 16px 24px;
            overflow: hidden;
            
            /* Viền Kim Loại 3D Đa Tầng */
            border: 1px solid rgba(255, 245, 166, 0.8);
            box-shadow: 
                0 0 0 3px #8b620a,
                0 0 0 6px #ffd700,
                0 0 0 9px #4a3200,
                0 0 40px rgba(0, 0, 0, 0.95),
                0 25px 50px rgba(0, 0, 0, 0.9),
                inset 0 0 35px rgba(0, 0, 0, 0.95),
                0 0 60px rgba(255, 180, 0, 0.25);
        }

        /* Hiệu Ứng Phản Chiếu Mặt Sàn Sòng Bài (Casino Floor Reflection) */
        .floor-reflection {
            position: absolute;
            bottom: -80px;
            left: 5%;
            width: 90%;
            height: 160px;
            background: radial-gradient(ellipse at center, rgba(255, 215, 0, 0.15) 0%, rgba(0,0,0,0) 70%);
            transform: rotateX(75deg);
            pointer-events: none;
            filter: blur(8px);
            z-index: 1;
        }

        /* Ánh Sáng Quét Qua Viền Kim Loại (Metallic Shimmer/Shine Effect) */
        .shimmer-line {
            position: absolute;
            top: -50%; left: -100%;
            width: 60%; height: 200%;
            background: linear-gradient(90deg, 
                transparent 0%, 
                rgba(255, 255, 255, 0.05) 30%, 
                rgba(255, 255, 255, 0.45) 50%, 
                rgba(255, 255, 255, 0.05) 70%, 
                transparent 100%);
            transform: rotate(30deg);
            animation: shineSweep 5s infinite cubic-bezier(0.4, 0, 0.2, 1);
            pointer-events: none;
            z-index: 15;
        }

        @keyframes shineSweep {
            0% { left: -120%; }
            30% { left: 180%; }
            100% { left: 180%; }
        }

        /* Aura Chiếu Sáng Trung Tâm */
        .game-container::before {
            content: '';
            position: absolute;
            top: -15%;
            left: 50%;
            transform: translateX(-50%);
            width: 850px;
            height: 300px;
            background: radial-gradient(ellipse, rgba(255, 215, 0, 0.18) 0%, rgba(0, 0, 0, 0) 70%);
            pointer-events: none;
            animation: pulseAura 3s ease-in-out infinite alternate;
        }

        @keyframes pulseAura {
            0% { opacity: 0.6; transform: translateX(-50%) scale(0.95); }
            100% { opacity: 1; transform: translateX(-50%) scale(1.05); }
        }

        /* --- HEADER --- */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
        }

        .logo-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            filter: drop-shadow(0 0 15px rgba(255, 215, 0, 0.9));
            transition: transform 0.25s ease;
            position: relative;
        }

        .logo-box:hover { transform: scale(1.06); }

        /* Tia Sáng Bạc Bọc Logo */
        .logo-sparkle {
            position: absolute;
            top: -5px;
            right: -10px;
            width: 20px;
            height: 20px;
            animation: rotateSparkle 4s linear infinite;
        }

        @keyframes rotateSparkle {
            0% { transform: rotate(0deg) scale(0.8); opacity: 0.5; }
            50% { transform: rotate(180deg) scale(1.2); opacity: 1; }
            100% { transform: rotate(360deg) scale(0.8); opacity: 0.5; }
        }

        .logo {
            font-size: 40px;
            font-weight: 900;
            background: linear-gradient(180deg, #ffffff 0%, #fff2a3 25%, #ffd700 50%, #d48800 80%, #5e0000 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 3px;
            font-style: italic;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.9));
        }

        .sub-logo {
            font-size: 10px;
            color: #ffe066;
            background: linear-gradient(180deg, #2a1a08 0%, #000 100%);
            border: 1px solid var(--gold-primary);
            padding: 2px 12px;
            border-radius: 10px;
            margin-top: -6px;
            font-weight: 800;
            letter-spacing: 2px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.9), inset 0 0 4px rgba(255,215,0,0.5);
        }

        .nav-tabs {
            display: flex;
            gap: 8px;
            background: rgba(0, 0, 0, 0.65);
            padding: 5px;
            border-radius: 24px;
            border: 1px solid rgba(212, 175, 55, 0.4);
            box-shadow: inset 0 0 12px rgba(0,0,0,0.9);
        }

        .tab-btn {
            background: linear-gradient(180deg, #2d1d0e 0%, #120903 100%);
            border: 1px solid #735712;
            color: #d4af37;
            padding: 8px 20px;
            border-radius: 18px;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.25s ease;
            text-shadow: 0 1px 3px #000;
        }

        .tab-btn:hover, .tab-btn.active {
            background: linear-gradient(180deg, #ffffff 0%, #ffd700 40%, #b8860b 85%, #573a00 100%);
            color: #0d0700;
            text-shadow: none;
            box-shadow: 0 0 16px rgba(255, 215, 0, 0.8);
            border-color: #fff;
        }

        .announcement {
            font-size: 11px;
            color: #f0e0c0;
            max-width: 250px;
            text-align: right;
            line-height: 1.35;
            background: rgba(10, 6, 3, 0.85);
            padding: 8px 14px;
            border-radius: 10px;
            border-right: 3px solid var(--gold-primary);
            box-shadow: inset 0 0 8px rgba(0,0,0,0.8);
        }

        /* --- GAME CAROUSEL SECTION (GÓC NHÌN PERSPECTIVE 3D) --- */
        .game-list {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            padding: 10px 0;
            z-index: 5;
            transform-style: preserve-3d;
        }

        /* Card Khung Kim Loại 3D Thực Tế */
        .card {
            width: 200px;
            height: 365px;
            background: linear-gradient(180deg, rgba(48, 32, 18, 0.95) 0%, rgba(18, 10, 5, 0.98) 60%, rgba(4, 2, 1, 1) 100%);
            border-radius: 20px;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 14px 10px 12px 10px;
            cursor: pointer;
            transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            overflow: hidden;

            /* Viền Đa Tầng Metallic 3D Card */
            border: 1px solid rgba(255, 230, 120, 0.9);
            box-shadow: 
                0 0 0 2px #7a580d,
                0 0 0 3.5px #d4af37,
                0 15px 30px rgba(0,0,0,0.95),
                inset 0 1px 3px rgba(255,255,255,0.4),
                inset 0 0 20px rgba(0,0,0,0.9);
        }

        .card:hover {
            transform: translateY(-12px) translateZ(20px) scale(1.03);
            border-color: #ffffff;
            box-shadow: 
                0 0 0 2px #ffd700,
                0 0 0 4px #ffffff,
                0 22px 40px rgba(255, 215, 0, 0.45), 
                inset 0 0 25px rgba(255, 215, 0, 0.35);
        }

        /* Badge Mới Ra Mắt / HOT / LIVE Pure Graphic */
        .badge {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(180deg, #ff4d4d 0%, #b30000 100%);
            color: #fff;
            font-size: 9px;
            font-weight: 900;
            padding: 3px 14px;
            border-bottom-left-radius: 8px;
            border-bottom-right-radius: 8px;
            border: 1px solid #ffe066;
            border-top: none;
            text-transform: uppercase;
            box-shadow: 0 4px 10px rgba(255, 0, 0, 0.7);
            letter-spacing: 1px;
            z-index: 6;
        }

        .card-title {
            font-size: 16px;
            font-weight: 900;
            background: linear-gradient(180deg, #ffffff 0%, #ffd700 65%, #b8860b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-align: center;
            margin-top: 10px;
            line-height: 1.15;
            filter: drop-shadow(0 2px 5px rgba(0,0,0,0.9));
            text-transform: uppercase;
        }

        .card-title.red {
            background: linear-gradient(180deg, #ffffff 0%, #ff5252 65%, #990000 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .card-title.cyan {
            background: linear-gradient(180deg, #ffffff 0%, #00ffff 65%, #0077aa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Card Graphic Box chứa các Icon SVG Pure Graphic */
        .card-graphic {
            width: 100%;
            height: 155px;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .graphic-svg {
            width: 125px;
            height: 125px;
            filter: drop-shadow(0 12px 18px rgba(0,0,0,0.95));
            transition: transform 0.35s ease;
        }

        .card:hover .graphic-svg {
            transform: scale(1.14) rotate(2deg);
        }

        /* Jackpot & Rates Display Box */
        .jackpot-box {
            background: radial-gradient(ellipse at center, #1f1408 0%, #000000 100%);
            border: 1px solid #7a5e1c;
            border-radius: 10px;
            width: 100%;
            padding: 8px 6px;
            text-align: center;
            box-shadow: inset 0 0 12px rgba(0,0,0,0.95), 0 2px 6px rgba(0,0,0,0.8);
            position: relative;
            overflow: hidden;
        }

        .jackpot-val {
            color: #00ffcc;
            font-family: 'Consolas', 'Courier New', monospace;
            font-weight: bold;
            font-size: 13px;
            text-shadow: 0 0 10px rgba(0, 255, 204, 0.9);
            letter-spacing: 0.5px;
        }

        .tai-xiu-rates {
            display: flex;
            justify-content: space-between;
            width: 100%;
            font-size: 11px;
            font-weight: bold;
            padding: 0 2px;
        }

        .rate-tai { color: #ff3300; text-shadow: 0 0 8px rgba(255, 51, 0, 0.8); }
        .rate-xiu { color: #00ffff; text-shadow: 0 0 8px rgba(0, 255, 255, 0.8); }

        /* --- FOOTER BAR --- */
        .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 20px;
            background: linear-gradient(180deg, rgba(28, 18, 10, 0.95) 0%, rgba(5, 3, 1, 0.98) 100%);
            border: 1px solid rgba(212, 175, 55, 0.6);
            border-radius: 16px;
            z-index: 10;
            box-shadow: 0 -6px 25px rgba(0,0,0,0.8), inset 0 1px 2px rgba(255,255,255,0.2);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar-frame {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            border: 2px solid var(--gold-primary);
            background: radial-gradient(circle, #333 0%, #000 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 14px rgba(255, 215, 0, 0.6);
            overflow: hidden;
        }

        .avatar-frame svg {
            width: 28px;
            height: 28px;
        }

        .user-details {
            display: flex;
            flex-direction: column;
        }

        .username {
            font-size: 12px;
            color: #ddd;
            font-weight: 700;
        }

        .balance {
            font-size: 17px;
            color: var(--gold-primary);
            font-weight: 900;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.8);
            font-family: 'Consolas', monospace;
        }

        .btn-deposit {
            background: linear-gradient(180deg, #ffffff 0%, #ffd700 30%, #b8860b 85%, #4a3300 100%);
            color: #000;
            font-weight: 900;
            font-size: 15px;
            padding: 10px 28px;
            border: 1px solid #fff;
            border-radius: 10px;
            cursor: pointer;
            box-shadow: 0 0 18px rgba(255, 215, 0, 0.7);
            letter-spacing: 1px;
            transition: all 0.25s ease;
            text-transform: uppercase;
        }

        .btn-deposit:hover {
            transform: scale(1.06);
            box-shadow: 0 0 28px rgba(255, 215, 0, 1);
        }

        .footer-actions {
            display: flex;
            gap: 20px;
        }

        .action-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 10px;
            color: #aaa;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.2s;
        }

        .action-btn:hover {
            color: var(--gold-primary);
            transform: translateY(-3px);
        }

        .action-icon-svg {
            width: 22px;
            height: 22px;
            margin-bottom: 3px;
            filter: drop-shadow(0 2px 5px rgba(0,0,0,0.9));
        }

        /* Floating Mini Game Trigger (Pure Glow Graphics) */
        .mini-game-widget {
            position: absolute;
            right: 18px;
            bottom: 78px;
            width: 68px;
            height: 68px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, #ff5252 0%, #b30000 70%, #3a0000 100%);
            border: 2px solid #ffe066;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 22px rgba(255, 0, 0, 0.8), inset 0 0 12px rgba(255,255,255,0.5);
            cursor: pointer;
            z-index: 20;
            animation: pulseWidget 2s infinite alternate;
        }

        @keyframes pulseWidget {
            0% { transform: scale(1); }
            100% { transform: scale(1.08); box-shadow: 0 0 32px rgba(255, 0, 0, 1), inset 0 0 15px rgba(255,255,255,0.7); }
        }

        .mini-game-widget span {
            font-size: 10px;
            font-weight: 900;
            color: #fff;
            text-align: center;
            line-height: 1.1;
            text-shadow: 0 2px 4px #000;
        }

        /* Modal Dialog */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(8px);
            justify-content: center;
            align-items: center;
            z-index: 100;
        }

        .modal-content {
            background: linear-gradient(180deg, #2b1a0a 0%, #0d0804 100%);
            border: 2px solid var(--gold-primary);
            border-radius: 18px;
            padding: 30px;
            width: 340px;
            text-align: center;
            box-shadow: 0 0 50px rgba(255, 215, 0, 0.6);
            position: relative;
        }

        .close-btn {
            position: absolute;
            top: 12px; right: 16px;
            color: #fff;
            font-size: 22px;
            cursor: pointer;
            font-weight: bold;
        }

        .close-btn:hover { color: var(--gold-primary); }
    </style>
</head>
<body>

    <!-- Canvas Particle Background -->
    <canvas id="bg-canvas"></canvas>

    <!-- Stage Wrapper for Scaling Engine (16:9) -->
    <div class="stage-wrapper" id="stage">
        <div class="floor-reflection"></div>
        
        <div class="game-container">
            <div class="shimmer-line"></div>

            <!-- --- HEADER --- -->
            <header class="header">
                <div class="logo-box">
                    <!-- SVG Sparkle Tia Sáng Logo -->
                    <svg class="logo-sparkle" viewBox="0 0 50 50">
                        <path d="M25,0 L30,20 L50,25 L30,30 L25,50 L20,30 L0,25 L20,20 Z" fill="#ffffff"/>
                    </svg>
                    <div class="logo">GO88</div>
                    <div class="sub-logo">TAIGO88.DE</div>
                </div>

                <nav class="nav-tabs">
                    <button class="tab-btn active">ALL GAME</button>
                    <button class="tab-btn">GAME BÀI</button>
                    <button class="tab-btn">SLOTS</button>
                    <button class="tab-btn">QUAY SỐ</button>
                </nav>

                <div class="announcement">
                    Hệ thống bảo mật quốc tế. Trải nghiệm cổng game bài đổi thưởng đỉnh cao 2026.
                </div>
            </header>

            <!-- --- GAME LIST (PURE GRAPHIC SVG 3D) --- -->
            <main class="game-list">

                <!-- Card 1: Xóc Đĩa Livestream -->
                <div class="card" onclick="openModal('XÓC ĐĨA LIVESTREAM')">
                    <div class="badge">Mới Ra Mắt</div>
                    <div class="card-title">XÓC ĐĨA<br><small style="font-size:10px; color:#aaa;-webkit-text-fill-color:#aaa;">Livestream</small></div>
                    <div class="card-graphic">
                        <svg class="graphic-svg" viewBox="0 0 100 100">
                            <defs>
                                <radialGradient id="plateGrad3D" cx="40%" cy="30%" r="70%">
                                    <stop offset="0%" stop-color="#ffffff"/>
                                    <stop offset="50%" stop-color="#e6e6e6"/>
                                    <stop offset="85%" stop-color="#888888"/>
                                    <stop offset="100%" stop-color="#333333"/>
                                </radialGradient>
                                <radialGradient id="redChip3D" cx="35%" cy="35%" r="65%">
                                    <stop offset="0%" stop-color="#ff8888"/>
                                    <stop offset="40%" stop-color="#dd0000"/>
                                    <stop offset="100%" stop-color="#550000"/>
                                </radialGradient>
                                <radialGradient id="bowlGrad3D" cx="30%" cy="20%" r="80%">
                                    <stop offset="0%" stop-color="#ffe899"/>
                                    <stop offset="50%" stop-color="#d4af37"/>
                                    <stop offset="100%" stop-color="#543d03"/>
                                </radialGradient>
                            </defs>
                            <!-- Plate Base & Shadow -->
                            <ellipse cx="50" cy="72" rx="44" ry="18" fill="rgba(0,0,0,0.6)"/>
                            <ellipse cx="50" cy="68" rx="44" ry="18" fill="url(#plateGrad3D)" stroke="#ffd700" stroke-width="1.5"/>
                            <ellipse cx="50" cy="67" rx="36" ry="13" fill="#1a1a1a" opacity="0.15"/>
                            
                            <!-- 4 Chips Positioned 3D -->
                            <ellipse cx="40" cy="66" rx="7" ry="4" fill="url(#redChip3D)" stroke="#fff" stroke-width="0.8"/>
                            <ellipse cx="58" cy="64" rx="7" ry="4" fill="#ffffff" stroke="#999" stroke-width="0.8"/>
                            <ellipse cx="48" cy="70" rx="7" ry="4" fill="url(#redChip3D)" stroke="#fff" stroke-width="0.8"/>
                            <ellipse cx="54" cy="62" rx="7" ry="4" fill="#ffffff" stroke="#999" stroke-width="0.8"/>

                            <!-- Metallic Bowl Top Dome -->
                            <path d="M 18,52 C 18,22 82,22 82,52 C 70,58 30,58 18,52 Z" fill="url(#bowlGrad3D)" stroke="#fff" stroke-width="1"/>
                            <ellipse cx="50" cy="24" rx="8" ry="4" fill="#ffe899" stroke="#b8860b" stroke-width="1"/>
                        </svg>
                    </div>
                    <div class="jackpot-box">
                        <div style="font-size:10px; color:#aaa;">Trực Tiếp</div>
                        <div class="jackpot-val">ONLINE 1,842</div>
                    </div>
                </div>

                <!-- Card 2: Kho Báu Tứ Linh -->
                <div class="card" onclick="openModal('KHO BÁU TỨ LINH')">
                    <div class="card-title">KHO BÁU<br>Tứ Linh</div>
                    <div class="card-graphic">
                        <svg class="graphic-svg" viewBox="0 0 100 100">
                            <defs>
                                <radialGradient id="dragonOrb" cx="35%" cy="35%" r="65%">
                                    <stop offset="0%" stop-color="#ffffff"/>
                                    <stop offset="30%" stop-color="#ffea75"/>
                                    <stop offset="75%" stop-color="#ff6600"/>
                                    <stop offset="100%" stop-color="#800000"/>
                                </radialGradient>
                                <filter id="glowDragon" x="-20%" y="-20%" width="140%" height="140%">
                                    <feGaussianBlur stdDeviation="3" result="blur" />
                                    <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                                </filter>
                            </defs>
                            <!-- Dragon Glow Aura -->
                            <circle cx="50" cy="50" r="32" fill="url(#dragonOrb)" filter="url(#glowDragon)"/>
                            <!-- 3D Dragon Claw Ring Graphic -->
                            <path d="M 20,50 Q 50,15 80,50 Q 50,85 20,50 Z" fill="none" stroke="#ffd700" stroke-width="3" opacity="0.7"/>
                            <path d="M 50,15 L 56,32 L 44,32 Z" fill="#ffffff"/>
                            <path d="M 50,85 L 56,68 L 44,68 Z" fill="#ffffff"/>
                            <path d="M 15,50 L 32,44 L 32,56 Z" fill="#ffffff"/>
                            <path d="M 85,50 L 68,44 L 68,56 Z" fill="#ffffff"/>
                            <!-- Center Gem Light Rays -->
                            <circle cx="50" cy="50" r="10" fill="#ffffff" opacity="0.9"/>
                        </svg>
                    </div>
                    <div class="jackpot-box">
                        <div class="jackpot-val" id="jackpot1">$ 25,541,283</div>
                        <div class="jackpot-val" id="jackpot2" style="font-size:11px; color:#88dccf;">$ 517,552,830</div>
                    </div>
                </div>

                <!-- Card 3: Tài Xỉu -->
                <div class="card" onclick="openModal('TÀI XỈU CANH TÝ')">
                    <div class="badge">HOT</div>
